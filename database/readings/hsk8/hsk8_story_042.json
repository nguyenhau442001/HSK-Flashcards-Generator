  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hiện tượng 'phòng vang thông tin' (Echo Chamber) trên mạng xã hội hình thành do đâu?",
      "options_vi": [
        "Do đứt cáp quang biển",
        "Do thuật toán gợi ý liên tục cung cấp các nội dung cùng quan điểm để câu tương tác, làm người dùng chỉ nghe thấy tiếng vọng của chính mình",
        "Do máy tính bị nhiễm virus"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 在封闭同质的回音室内部，群体不断重复、强化片面观点，理性的声音被驱逐."
    },
    {
      "id": "q2",
      "question_vi": "Hậu quả nguy hại của hiện tượng 'bộ lạc hóa' và cực đoan hóa trên mạng đối với xã hội thực là gì?",
      "options_vi": [
        "Làm giá cước mạng tăng cao",
        "Xé rách niềm tin chính trị, gây thù hận đối đầu gay gắt giữa các nhóm cộng đồng và phá vỡ đồng thuận xã hội",
        "Khiến mọi người không dùng điện thoại nữa"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 政治互信与跨阶层理性共识遭到严重撕裂，带来系统性内耗危机."
    },
    {
      "id": "q3",
      "question_vi": "Giải pháp công nghệ để phá vỡ kén thông tin là gì?",
      "options_vi": [
        "Chỉ cho phép đọc báo giấy",
        "Bắt buộc thuật toán phải hiển thị các quan điểm đa chiều đối lập một cách cân bằng và hạ bớt ưu tiên cho các bài viết kích động cực đoan",
        "Xóa toàn bộ các bình luận"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 强制引入多元观点交叉曝光与对抗性降权机制，是打破回音壁的钥匙."
    }
  ]
