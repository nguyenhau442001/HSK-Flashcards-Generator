  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hai nguyên tắc pháp lý tối cao điều chỉnh việc khai thác sông ngòi quốc tế là gì?",
      "options_vi": [
        "Nguyên tắc nước ai nấy dùng",
        "Sử dụng công bằng hợp lý (Equitable Utilization) và Không gây thiệt hại đáng kể (No Significant Harm)",
        "Nước nào giàu hơn có quyền múc hết nước"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 公平合理利用原则与不造成重大损害原则构成了双核心支柱."
    },
    {
      "id": "q2",
      "question_vi": "Quan điểm nào từng đòi trao quyền tùy tiện ngăn sông đắp đập cho nước thượng nguồn đã bị luật quốc tế bác bỏ?",
      "options_vi": [
        "Học thuyết tự do thương mại",
        "Học thuyết chủ quyền lãnh thổ tuyệt đối (Harmon Doctrine - 绝对领土主权理论)",
        "Luật hàng hải thế giới"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 绝对领土主权理论企图赋予上游国任意截流的特权，已被全盘否定."
    },
    {
      "id": "q3",
      "question_vi": "Nghĩa vụ thủ tục bắt buộc trước khi một nước xây dựng dự án lớn trên sông quốc tế là gì?",
      "options_vi": [
        "Lén lút xây dựng trong đêm",
        "Đánh giá tác động môi trường xuyên biên giới và thông báo tham vấn thiện chí với các nước hạ nguồn",
        "Cấm các nước khác qua lại"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 负有开展跨界环境影响评价、事先通报协商的严格程序性法定义务."
    }
  ]
