  "quiz": [
    {
      "id": "q1",
      "question_vi": "Nguyên nhân cốt lõi khiến các loài sinh vật ngoại lai xâm hại phát triển bùng nổ tàn phá môi trường mới là gì?",
      "options_vi": [
        "Vì chúng không ăn bất cứ thứ gì",
        "Do môi trường mới hoàn toàn vắng bóng các loài thiên địch tự nhiên để kiềm chế sinh sản của chúng",
        "Do chúng chỉ sống được vài ngày"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 外来入侵物种由于缺乏天敌制约而迅速疯狂泛滥蔓延."
    },
    {
      "id": "q2",
      "question_vi": "Hành vi vô ý thức nào của người dân thường vô tình gây họa cho hệ sinh thái bản địa?",
      "options_vi": [
        "Trồng cây xanh trong vườn nhà",
        "Tự ý mua và thả các loài sinh vật lạ (phóng sinh mù quáng) ra ao hồ tự nhiên",
        "Dọn dẹp rác bờ sông"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 借助跨境物流与非法盲目放生等渠道隐蔽扩散."
    },
    {
      "id": "q3",
      "question_vi": "Biện pháp pháp lý mạnh tay được quy định trong Luật An toàn Sinh học là gì?",
      "options_vi": [
        "Không can thiệp vào thị trường buôn bán sinh vật lạ",
        "Quy định trách nhiệm hình sự nghiêm khắc đối với hành vi tự ý nhập lậu và thả sinh vật ngoại lai nguy hại",
        "Khuyến khích nuôi thả cá sấu ngoại lai"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 设立严禁非法引进与擅自放生的刑事责任条款，以严刑峻法守护生态平衡."
    }
  ]
