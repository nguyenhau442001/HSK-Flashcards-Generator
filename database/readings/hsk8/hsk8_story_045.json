  "quiz": [
    {
      "id": "q1",
      "question_vi": "Xu hướng mở rộng phạm vi thẩm tra an ninh quốc gia (National Security Review) hiện nay bao gồm những lĩnh vực nào?",
      "options_vi": [
        "Chỉ bao gồm sản xuất súng đạn",
        "Mở rộng sang chất bán dẫn, hạ tầng mạng, dữ liệu cá nhân nhạy cảm quy mô lớn và chuỗi y dược phẩm",
        "Chỉ kiểm tra hàng dệt may"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 审查范畴急剧扩展至先进半导体、关键通信基础设施、大规模数据及生物医药."
    },
    {
      "id": "q2",
      "question_vi": "Hệ lụy tiêu cực khi một quốc gia lạm dụng thái quá lý do 'an ninh quốc gia' để từ chối đầu tư nước ngoài là gì?",
      "options_vi": [
        "Làm cho nền kinh tế thịnh vượng hơn",
        "Biến tướng thành chủ nghĩa bảo hộ đầu tư mù quáng, làm xói mòn niềm tin thị trường và gây đứt gãy chuỗi sản xuất toàn cầu",
        "Không có tác động nào"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 过度工具化极易蜕变为保护主义，更在无形中撕裂了全球产业链高效分工."
    },
    {
      "id": "q3",
      "question_vi": "Giải pháp pháp lý để cân bằng giữa bảo đảm an ninh và duy trì môi trường đầu tư cởi mở là gì?",
      "options_vi": [
        "Cấm hoàn toàn mọi dòng vốn nước ngoài",
        "Minh bạch hóa danh mục rà soát và áp dụng cơ chế phê chuẩn có điều kiện (Mitigation Agreements) để gỡ bỏ lo ngại",
        "Để nhà đầu tư tự do làm mọi điều tùy ý"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 建立透明清晰的标准并健全附条件批准缓解协议机制，是法理支点."
    }
  ]
