  "quiz": [
    {
      "id": "q1",
      "question_vi": "Luật sư bào chữa thường dùng kết quả quét não để lập luận điều gì cho bị cáo?",
      "options_vi": [
        "Chứng minh bị cáo hoàn toàn khỏe mạnh",
        "Chứng minh tổn thương thùy trán làm suy giảm ý chí tự do và năng lực kiểm soát hành vi bạo lực để xin giảm nhẹ tội",
        "Đòi tiền viện phí của tòa án"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 援引额叶受损证据，试图证明被告人缺乏控制自身冲动的自由意志与主观罪过."
    },
    {
      "id": "q2",
      "question_vi": "Cảnh báo lớn nhất khi đưa hình ảnh quét não fMRI ra trước tòa là gì?",
      "options_vi": [
        "Hình ảnh quá mờ nhạt",
        "Màu sắc rực rỡ của ảnh quét não dễ gây định kiến khoa học thị giác (visual science bias), khiến thẩm phán đánh giá quá cao độ tin cậy",
        "Làm mất thời gian in ảnh"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 彩色图像极易产生诱导性的科学偏见，高估生理证据的证明力."
    },
    {
      "id": "q3",
      "question_vi": "Nguyên tắc cốt lõi của luật hình sự trước bước tiến của khoa học não bộ là gì?",
      "options_vi": [
        "Quy kết mọi tội lỗi cho gen và não bộ",
        "Kiên quyết bảo vệ giả định ý chí tự do và trách nhiệm đạo đức cá nhân, không để thuyết tất định thần kinh xóa nhòa ranh giới đúng sai",
        "Bãi bỏ toàn bộ bộ luật hình sự"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm và sáu viết: 防止神经决定论对道义归责原则的消解，坚定捍卫自由意志假定."
    }
  ]
