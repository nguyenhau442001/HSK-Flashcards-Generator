  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mối nguy hại tinh vi khi các ứng dụng AI bắt chước cảm xúc con người quá mức là gì?",
      "options_vi": [
        "Làm máy tính chạy chậm",
        "Doanh nghiệp khai thác điểm yếu tâm lý để thao túng ý thức, bán hàng ngầm và bóc lột tình cảm người cô đơn",
        "Không ai muốn mua điện thoại nữa"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 利用心理软肋实施隐蔽的商业诱导与意识操控，构成了对情感自由的隐性剥削."
    },
    {
      "id": "q2",
      "question_vi": "Hệ quả tâm lý đối với những người quá lệ thuộc vào chatbot làm bạn tâm giao là gì?",
      "options_vi": [
        "Trở thành diễn viên kịch giỏi",
        "Thu mình khỏi xã hội ngoài đời thực và suy giảm khả năng kết nối cảm xúc giữa con người với con người",
        "Không còn cần ăn cơm"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 导致个体在现实世界中的社交退缩与情感感知能力退化."
    },
    {
      "id": "q3",
      "question_vi": "Quy chuẩn đạo đức bắt buộc trong thiết kế AI tương tác cảm xúc là gì?",
      "options_vi": [
        "Phải giả vờ mình là con người thật",
        "Phải minh bạch thông báo cho người dùng biết đây là máy móc và nghiêm cấm trục lợi từ sự gắn kết tâm lý",
        "Thu thật nhiều phí đăng ký"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 强制明确告知互动对象为非生物算法程序，严禁利用情感依恋进行商业套利."
    }
  ]
