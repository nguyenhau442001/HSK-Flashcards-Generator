  "quiz": [
    {
      "id": "q1",
      "question_vi": "Vì sao kháng kháng sinh (AMR) được gọi là 'cơn sóng thần thầm lặng' đe dọa nền y học hiện đại?",
      "options_vi": [
        "Vì nó tạo ra tiếng ồn lớn",
        "Nếu kháng sinh mất tác dụng hoàn toàn, những vết thương nhỏ hay phẫu thuật thông thường cũng có thể gây chết người như thời trung cổ",
        "Vì thuốc kháng sinh quá đắt"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 人类将重回轻微感染或剖腹产手术即可致命的黑暗前抗生素时代."
    },
    {
      "id": "q2",
      "question_vi": "Nguyên nhân hàng đầu dẫn đến sự xuất hiện của các siêu vi khuẩn kháng thuốc là gì?",
      "options_vi": [
        "Uống quá nhiều nước ngọt",
        "Lạm dụng kê đơn kháng sinh bừa bãi trong chữa bệnh và trộn kháng sinh vào thức ăn chăn nuôi gia súc công nghiệp",
        "Do thời tiết quá nóng"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 临床过度处方与工业化畜禽养殖中抗生素的长期滥用，加速催生了超级细菌."
    },
    {
      "id": "q3",
      "question_vi": "Triết lý khoa học toàn diện nào được WHO kêu gọi áp dụng để kiểm soát kháng kháng sinh?",
      "options_vi": [
        "Mô hình tự dùng thuốc",
        "Triết lý 'Một Sức Khỏe' (One Health) kết hợp đồng bộ giữa y tế người, thú y và môi trường sinh thái",
        "Chỉ chữa cho động vật"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 践行涵盖人类、动植物与环境协同的一体化健康（One Health）理念是唯一出路."
    }
  ]
