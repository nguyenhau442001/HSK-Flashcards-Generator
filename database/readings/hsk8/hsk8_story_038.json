  "quiz": [
    {
      "id": "q1",
      "question_vi": "Khái niệm 'Bi kịch của tài sản chung' (Tragedy of the Commons) miêu tả hiện tượng gì?",
      "options_vi": [
        "Không ai thèm sử dụng tài nguyên",
        "Tài sản công cộng không có chủ sở hữu rõ ràng khiến mọi người đua nhau khai thác quá mức đến cạn kiệt",
        "Tài nguyên tự sinh sôi nảy nở"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 全球公地普遍面临着由于产权模糊而导致过度掠夺的公地悲剧困境."
    },
    {
      "id": "q2",
      "question_vi": "Đóng góp mang tính cách mạng của nhà kinh tế Nobel Elinor Ostrom đối với quản trị tài nguyên là gì?",
      "options_vi": [
        "Bắt buộc bán đấu giá toàn bộ tài nguyên cho tư nhân",
        "Chứng minh cộng đồng có thể tự xây dựng quy tắc tự quản (self-governance) và giám sát lẫn nhau hiệu quả mà không cần nhà nước can thiệp cực đoan",
        "Bỏ mặc cho tài nguyên tự tiêu vong"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 社群完全能够通过自治协议与声誉制约实现公共池塘资源的长效永续利用."
    },
    {
      "id": "q3",
      "question_vi": "Nguyên tắc thiết kế thể chế thành công của mô hình tự quản bao gồm gì?",
      "options_vi": [
        "Càng bí mật càng tốt",
        "Ranh giới người sử dụng rõ ràng, quy tắc khai thác theo hạn ngạch linh hoạt và chế tài xử phạt vi phạm tăng dần",
        "Phạt tiền thật nặng ngay lần đầu"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 确立清晰边界、制定分级提取规则并实施分级惩罚，构成核心原则."
    }
  ]
}