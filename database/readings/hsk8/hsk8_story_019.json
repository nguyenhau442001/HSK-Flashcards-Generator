  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hiện tượng 'quý tộc hóa đô thị' (gentrification) thường gây ra hậu quả tiêu cực gì cho cư dân gốc?",
      "options_vi": [
        "Giúp người nghèo giàu lên nhanh chóng",
        "Giá nhà và chi phí sinh hoạt tăng vọt đẩy cư dân thu nhập thấp bản địa phải di dời ra vùng ven xa xôi",
        "Làm cho đường phố bị bỏ hoang"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 原住中低收入居民在租金飞涨下被迫搬迁至城市边缘，社区网络被连根拔起."
    },
    {
      "id": "q2",
      "question_vi": "Lý thuyết về 'Quyền đối với không gian' (Right to the Space) khẳng định điều cốt lõi gì?",
      "options_vi": [
        "Không gian thành phố chỉ dành cho ai trả tiền cao nhất",
        "Đô thị là không gian sống công cộng bình đẳng của toàn thể cư dân chứ không phải hàng hóa đầu cơ độc quyền",
        "Mọi người phải sống ngoài trời"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 城市空间应当是全体市民平等享有的公共生活场所，而非特权商品."
    },
    {
      "id": "q3",
      "question_vi": "Biện pháp quy hoạch nào giúp bảo vệ người dân nghèo không bị bật bãi khỏi khu phố cũ?",
      "options_vi": [
        "Phá hủy toàn bộ nhà ở giá rẻ",
        "Bố trí nhà ở xã hội cho thuê tại chỗ, khống chế mức tăng giá thuê và mô hình sở hữu cộng đồng",
        "Cấm người nghèo quay lại trung tâm"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 通过配建保障性租赁住房、租金管制与共有产权模式，对冲排斥效应."
    }
  ]
