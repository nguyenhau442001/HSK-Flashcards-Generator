  "quiz": [
    {
      "id": "q1",
      "question_vi": "Tiêu chuẩn 'chết não' (brain death) khác biệt như thế nào so với quan niệm chết truyền thống?",
      "options_vi": [
        "Đo nhiệt độ cơ thể",
        "Xác định sự chấm dứt hoàn toàn và không thể đảo ngược của toàn bộ chức năng não bộ thay vì chỉ nhìn vào tim ngừng đập",
        "Chỉ cần người bệnh nhắm mắt ngủ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 全脑功能不可逆丧失的脑死亡标准，颠覆了以呼吸心跳骤停界定死亡的观念."
    },
    {
      "id": "q2",
      "question_vi": "Ý nghĩa thực tiễn lớn lao của việc công nhận tiêu chuẩn chết não trong y học là gì?",
      "options_vi": [
        "Giảm chi phí tiền thuốc",
        "Kịp thời bảo vệ chất lượng tạng ghép để cứu sống các bệnh nhân suy tạng giai đoạn cuối",
        "Để bệnh viện xuất viện sớm"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 为抢救器官衰竭病患的重症器官移植手术赢得了宝贵的时间窗口."
    },
    {
      "id": "q3",
      "question_vi": "Yêu cầu đạo đức tối thượng để ngăn chặn tiêu cực trong chẩn đoán chết não là gì?",
      "options_vi": [
        "Để bác sĩ phẫu thuật ghép tạng tự quyết định",
        "Quy trình chẩn đoán điện não đồ nghiêm ngặt độc lập và tôn trọng tuyệt đối quyền tự nguyện của thân nhân",
        "Bỏ qua ý kiến gia đình"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư và năm viết: 遵循严苛判定程序，确保绝不受制于器官获取的功利诱惑."
    }
  ]
