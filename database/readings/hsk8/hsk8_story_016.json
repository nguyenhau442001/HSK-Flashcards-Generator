  "quiz": [
    {
      "id": "q1",
      "question_vi": "Lợi ích lớn nhất mà hệ thống AI mang lại cho công tác tòa án là gì?",
      "options_vi": [
        "Tuyên án thay cho con người",
        "Tra cứu nhanh dữ liệu án lệ tương đồng, giảm áp lực hồ sơ và hỗ trợ thống nhất chuẩn mực lượng hình",
        "Sa thải toàn bộ hội đồng thẩm phán"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 高效检索压缩了案头时间，推动了司法尺度的统一与同案同判."
    },
    {
      "id": "q2",
      "question_vi": "Mối lo ngại lớn nhất khi thẩm phán phụ thuộc quá mức vào gợi ý của thuật toán AI là gì?",
      "options_vi": [
        "Hỏng bàn phím máy tính",
        "Hiệu ứng mỏ neo nhận thức làm tê liệt niềm tin nội tâm và tước đoạt quyền tự do phán quyết độc lập của thẩm phán",
        "Mất điện phòng xử án"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 对法官内心确信造成的认知锚定效应，极易演变为对自由裁量权的架空."
    },
    {
      "id": "q3",
      "question_vi": "Nguyên tắc đạo đức cốt tử của việc ứng dụng công nghệ trong tư pháp là gì?",
      "options_vi": [
        "AI là thẩm phán tối cao",
        "AI chỉ là công cụ hỗ trợ tham khảo, phán quyết cuối cùng phải do thẩm phán con người chịu trách nhiệm đạo đức quyết định",
        "Cấm hoàn toàn việc tra cứu máy tính"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 确立人工智能在司法审判中只能充当辅助参考而非替代决策者."
    }
  ]
