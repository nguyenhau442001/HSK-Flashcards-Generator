  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hiệu ứng Kessler (Kessler Syndrome) đưa ra lời cảnh báo nguy hiểm nào về quỹ đạo Trái Đất?",
      "options_vi": [
        "Trái Đất sẽ ngừng quay quanh Mặt Trời",
        "Mật độ rác vũ trụ va chạm dây chuyền sẽ biến không gian gần thành bãi phế thải bất khả xâm phạm trong hàng trăm năm",
        "Tất cả các vì sao sẽ tắt lịm"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 链式碰撞反应将使整个近地空间在数百年内彻底无法使用."
    },
    {
      "id": "q2",
      "question_vi": "Khoảng trống pháp lý lớn nhất trong các điều ước không gian hiện hành là gì?",
      "options_vi": [
        "Không cho phép phóng vệ tinh mới",
        "Chưa quy định rõ quyền tài phán để dọn dẹp rác vũ trụ của nước khác và trách nhiệm bồi thường khi thu gom",
        "Cấm chụp ảnh vũ trụ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 在界定空间物体清除的管辖权、主权放弃及责任归属层面存在制度空白."
    },
    {
      "id": "q3",
      "question_vi": "Công nghệ dọn dẹp rác vũ trụ chủ động (Active Debris Removal - ADR) gồm có những giải pháp nào?",
      "options_vi": [
        "Bắn súng trường từ mặt đất",
        "Dùng lưới phóng bắt rác, dùng tia laser bốc hơi quỹ đạo và dây buộc điện động kéo mảnh vỡ xuống khí quyển",
        "Để rác tự rơi xuống"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 研发飞网捕获、激光烧蚀与电动系绳等主动清除空间碎片的前沿工程技术."
    }
  ]
