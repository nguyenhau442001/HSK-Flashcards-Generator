  "quiz": [
    {
      "id": "q1",
      "question_vi": "Án lệ lò luyện kim Trail Smelter (Trail Smelter Case) nổi tiếng đã xác lập nguyên tắc môi trường quốc tế nào?",
      "options_vi": [
        "Quốc gia có quyền xả thải tùy ý trong biên giới của mình",
        "Nguyên tắc cấm sử dụng lãnh thổ gây thiệt hại đáng kể cho môi trường nước khác (No-harm rule)",
        "Nước bị ô nhiễm phải tự bỏ tiền dọn dẹp"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 特雷尔冶炼厂案确立了著名的原则，不得允许其领土被用于致使他国遭受重大损害."
    },
    {
      "id": "q2",
      "question_vi": "Vì sao nguyên tắc 'trách nhiệm nghiêm ngặt' (Strict Liability) được ưu tiên áp dụng trong ô nhiễm xuyên biên giới thay cho 'trách nhiệm dựa trên lỗi'?",
      "options_vi": [
        "Vì thủ tục đơn giản hơn",
        "Vì việc chứng minh lỗi chủ quan trong các thảm họa công nghiệp phức tạp là bất khả thi đối với nước nạn nhân",
        "Vì các nhà máy không có tiền"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 传统过错责任原则使受害国陷入证明绝境，加速向严格责任乃至绝对责任演进."
    },
    {
      "id": "q3",
      "question_vi": "Công cụ tài chính nào giúp đảm bảo tiền bồi thường được chi trả kịp thời khi xảy ra sự cố rò rỉ hóa chất xuyên quốc gia?",
      "options_vi": [
        "Vay nợ ngân hàng cá nhân",
        "Bảo hiểm trách nhiệm môi trường xuyên biên giới bắt buộc và Quỹ bồi thường khẩn cấp đa phương",
        "Kêu gọi quyên góp trên đường phố"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 建立强制性的跨国环境责任保险制度与多边应急赔偿补偿基金，保障修复权益."
    }
  ]
}