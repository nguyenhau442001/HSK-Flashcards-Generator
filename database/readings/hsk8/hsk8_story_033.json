  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hiện tượng 'chuỗi thảm họa phức hợp' (cascading disasters) ở các siêu đô thị diễn ra như thế nào?",
      "options_vi": [
        "Mọi người chỉ lo sợ trên mạng",
        "Một mắt xích hạ tầng bị đứt gãy (như mất điện) kéo theo tê liệt dây chuyền cấp nước, bệnh viện và mạng thông tin liên lạc",
        "Trời mưa làm đường hơi ướt"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 单一关键基础设施损毁极易触发多米诺骨牌式的复合灾害链条连锁反应."
    },
    {
      "id": "q2",
      "question_vi": "Mục tiêu cốt lõi của 'Đô thị kiên cường' (Resilient City) là gì?",
      "options_vi": [
        "Xây tường thành cao bao quanh thành phố",
        "Thiết kế khả năng dự phòng (redundancy), lưới điện phân tán và năng lực tự phục hồi nhanh chóng sau cú sốc bất ngờ",
        "Cấm dân cư ra khỏi nhà khi có gió"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 强调在规划设计中植入充分的物理冗余、微电网与模块化自愈式恢复机制."
    },
    {
      "id": "q3",
      "question_vi": "Giải pháp công trình giúp chặn đứng chuỗi thảm họa domino là gì?",
      "options_vi": [
        "Bỏ hoang các tầng hầm",
        "Cách ly chống ngập các trạm biến áp hiểm yếu và bố trí hào kỹ thuật ngầm đa năng có van ngắt an toàn",
        "Nối tất cả các dây điện vào một công tắc duy nhất"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 通过地下管廊立体防灾隔离与关键设备改造，实现灾害链条的物理性阻断."
    }
  ]
