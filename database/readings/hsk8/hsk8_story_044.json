  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mối lo ngại an ninh sinh học hàng đầu xuất phát từ sự phát triển của sinh học tổng hợp là gì?",
      "options_vi": [
        "Giá bánh mì làm từ men nhân tạo quá đắt",
        "Nguy cơ kẻ xấu sử dụng máy in DNA để tổng hợp nhân tạo các loại virus mầm bệnh cực độc nhằm mục đích khủng bố sinh học",
        "Vi sinh vật làm ô nhiễm nước mưa"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 高致病性病毒人工重组门槛降低，催生了严峻的生物恐怖主义阴影."
    },
    {
      "id": "q2",
      "question_vi": "Biện pháp kiểm soát bắt buộc đối với các công ty thương mại nhận đơn hàng in chuỗi gen DNA là gì?",
      "options_vi": [
        "Không cần hỏi tên khách hàng",
        "Bắt buộc dùng thuật toán quét rà soát chuỗi DNA đặt hàng, tự động chặn đứng và báo động nếu có chuỗi mầm bệnh nguy hiểm",
        "Giao hàng qua bưu điện không kiểm tra"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 建立强制性的订单序列安全比对算法，对涉及已知致命毒素序列实施拦截."
    },
    {
      "id": "q3",
      "question_vi": "Trách nhiệm đạo đức của các nhà khoa học trong lĩnh vực nghiên cứu lưỡng dụng (Dual-Use) là gì?",
      "options_vi": [
        "Tự do chế tạo vũ khí sinh học",
        "Thực hiện cam kết nghiên cứu vô hại vì sự sống và chịu sự giám sát của ủy ban an toàn sinh học độc lập",
        "Bán công nghệ cho ai trả giá cao nhất"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 推行无害科研承诺与设立两用生物技术伦理安全委员会，是坚固堤坝."
    }
  ]
