  "quiz": [
    {
      "id": "q1",
      "question_vi": "Nguồn vốn của các Quỹ tài sản có chủ quyền (Sovereign Wealth Funds) chủ yếu đến từ đâu?",
      "options_vi": [
        "Tiền quyên góp từ thiện",
        "Thặng dư xuất khẩu tài nguyên thiên nhiên (như dầu mỏ) hoặc dự trữ ngoại hối tích lũy của quốc gia",
        "In tiền giấy phát không"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 源自资源输出国巨额顺差或国家外汇储备积累的主权基金."
    },
    {
      "id": "q2",
      "question_vi": "Rào cản lớn nhất mà các quỹ chủ quyền gặp phải khi đầu tư vào công nghệ cao ở nước ngoài là gì?",
      "options_vi": [
        "Không đủ tiền mua cổ phiếu",
        "Bị nước tiếp nhận đầu tư viện cớ an ninh quốc gia (như thẩm tra CFIUS) để ngăn cấm và từ chối cấp phép",
        "Không biết tiếng nước ngoài"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 投资东道国频繁以国家安全为借口收紧审查，设立严苛准入高墙."
    },
    {
      "id": "q3",
      "question_vi": "Bộ quy tắc quốc tế Santiago (Santiago Principles) yêu cầu các quỹ chủ quyền cam kết điều gì?",
      "options_vi": [
        "Phải phục vụ mục đích quân sự",
        "Bảo đảm tính minh bạch, vận hành thuần túy vì mục tiêu lợi nhuận thương mại và không mang động cơ chính trị",
        "Chỉ được gửi tiền tiết kiệm"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 在《圣地亚哥原则》框架下要求保持高度透明度、商业驱动性与非政治化承诺."
    }
  ]
