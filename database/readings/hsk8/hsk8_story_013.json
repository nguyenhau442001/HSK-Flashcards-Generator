  "quiz": [
    {
      "id": "q1",
      "question_vi": "Bản chất của hiện tượng 'định kiến thuật toán' (algorithmic bias) bắt nguồn từ đâu?",
      "options_vi": [
        "Do máy tính tự nhiên ghét bỏ con người",
        "Do dữ liệu huấn luyện trong quá khứ chứa sẵn định kiến và sự phân biệt đối xử của xã hội",
        "Do virus máy tính phá hoại"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 训练数据中所包含的历史歧视与社会偏见极易被数学模型系统性放大."
    },
    {
      "id": "q2",
      "question_vi": "Giải pháp then chốt để phá vỡ tính mờ đục của 'hộp đen thuật toán' là gì?",
      "options_vi": [
        "Tin tưởng tuyệt đối vào lập trình viên",
        "Kiểm toán thuật toán độc lập của bên thứ ba và bắt buộc công bố đánh giá tác động",
        "Tắt toàn bộ hệ thống máy tính"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 推行独立的第三方算法伦理审计，强制公开评估报告与特征权重."
    },
    {
      "id": "q3",
      "question_vi": "Khái niệm 'Công lý dữ liệu' (Data Justice) đòi hỏi điều gì ngay từ khâu thiết kế mô hình?",
      "options_vi": [
        "Càng nhiều dữ liệu bẩn càng tốt",
        "Lọc sạch định kiến cấu trúc từ nguồn dữ liệu và đưa ràng buộc toán học chống phân biệt đối xử vào thuật toán",
        "Không cần quan tâm đến đạo đức"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 从源头清洗带有偏见的语料库，并在模型优化中植入反歧视数学约束."
    }
  ]
