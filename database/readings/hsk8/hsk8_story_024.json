  "quiz": [
    {
      "id": "q1",
      "question_vi": "Địa vị pháp lý quốc tế của tài nguyên đáy biển sâu theo UNCLOS là gì?",
      "options_vi": [
        "Thuộc sở hữu riêng của nước giàu nhất",
        "Là tài sản thừa kế chung của toàn nhân loại (Common Heritage of Mankind)",
        "Ai tìm thấy trước người đó hưởng"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 国际海底区域及其多金属结核资源，被确立为全人类共同继承财产."
    },
    {
      "id": "q2",
      "question_vi": "Vì sao các nhà bảo vệ môi trường kịch liệt phản đối việc vội vã khai thác đáy biển sâu?",
      "options_vi": [
        "Vì đáy biển không có kim loại",
        "Vì hệ sinh thái đáy biển sâu cực kỳ mong manh, phát triển chậm chạp và dễ bị hủy diệt vĩnh viễn không thể phục hồi",
        "Vì chi phí đóng tàu quá rẻ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 可能对极其脆弱、生长极其缓慢的深海底栖生物群落造成不可逆浩劫."
    },
    {
      "id": "q3",
      "question_vi": "Khoáng sản kết hạch đa kim ở đáy biển chứa các kim loại chiến lược nào được ngành xe điện thèm muốn?",
      "options_vi": [
        "Vàng và kim cương",
        "Niken, coban, đồng và mangan dùng chế tạo pin năng lượng",
        "Than bùn và dầu hỏa"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ hai viết: 富含镍、钴、铜、锰等制造新能源动力电池不可或缺的关键元素."
    }
  ]
