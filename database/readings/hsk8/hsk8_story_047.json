  "quiz": [
    {
      "id": "q1",
      "question_vi": "Tác dụng tích cực của mô hình phân tích dữ liệu lớn bản án trong xét xử là gì?",
      "options_vi": [
        "Tự động kết án không cần thẩm phán",
        "Hạn chế hiện tượng cùng tội nhưng mức án quá chênh lệch (同案不同判), hỗ trợ chuẩn hóa khung lượng hình công bằng",
        "Sa thải toàn bộ thư ký tòa án"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 为破解同案不同判的痼疾提供了透镜，实时比对法定酌定量刑情节分布区间."
    },
    {
      "id": "q2",
      "question_vi": "Cơ chế cảnh báo tự động sẽ kích hoạt khi nào?",
      "options_vi": [
        "Khi bị cáo xin giảm án",
        "Khi mức án đề xuất của thẩm phán chênh lệch bất thường so với phân bố lịch sử của các vụ án tương tự",
        "Khi phiên tòa kéo dài quá 2 giờ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 若宣告刑大幅偏离同类案件的历史中位数分布，系统自动触发复核预警."
    },
    {
      "id": "q3",
      "question_vi": "Nguy cơ sai lệch lớn nhất nếu lạm dụng máy móc dữ liệu lớn trong tuyên án là gì?",
      "options_vi": [
        "Mô hình máy tính bị chậm",
        "Cố kết hóa các bất công, chênh lệch vùng miền trong quá khứ thành quy chuẩn máy móc, tước đoạt sự thấu cảm nhân văn trong từng vụ án cụ thể",
        "Bản án quá dài"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư và năm viết: 将过往隐性偏见固化为标准参数，防范对个案实质正义与自由裁量的机械扼杀."
    }
  ]
