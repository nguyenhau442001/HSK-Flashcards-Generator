  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mối nguy hại xã hội lớn nhất từ việc rò rỉ dữ liệu xét nghiệm gen thương mại là gì?",
      "options_vi": [
        "Không biết được nguồn gốc tổ tiên",
        "Bị công ty bảo hiểm và nhà tuyển dụng phân biệt đối xử, từ chối bán bảo hiểm hoặc từ chối tuyển dụng vì gen có nguy cơ mắc bệnh",
        "Tốn tiền mua que thử"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 商业保险与雇主可能利用基因风险实施隐蔽歧视，将携带突变个体拒之门外."
    },
    {
      "id": "q2",
      "question_vi": "Đặc tính khác biệt lớn nhất của 'thông tin gen' so với các dữ liệu cá nhân khác là gì?",
      "options_vi": [
        "Gen có thể đổi mã số như thẻ tín dụng",
        "Thông tin gen mang tính chia sẻ dòng họ, một người làm lộ sẽ ảnh hưởng đến cả gia đình và con cháu đời sau",
        "Gen biến mất sau một ngày"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 基因信息具有家族共有属性，一人泄露将不可逆波及同胞与后代隐私."
    },
    {
      "id": "q3",
      "question_vi": "Giải pháp pháp lý căn bản để ngăn chặn phân biệt đối xử bằng gen là gì?",
      "options_vi": [
        "Cấm chữa bệnh cho người mang đột biến gen",
        "Ban hành luật chống phân biệt đối xử bằng gen (GINA) và cấm các công ty trục lợi từ dữ liệu DNA cá nhân",
        "Bắt mọi người phải công khai kết quả gen"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 出台反基因歧视专门立法，确立基因数据的人格权属性并禁止商业滥用."
    }
  ]
