  "quiz": [
    {
      "id": "q1",
      "question_vi": "Quy tắc đột phá nào trong hiệp định RCEP giúp tối ưu hóa chi phí sản xuất xuyên quốc gia?",
      "options_vi": [
        "Quy tắc cấm hoàn toàn thương mại hàng trung gian",
        "Quy tắc xuất xứ cộng gộp (原产地累积规则) giúp giảm thuế nhập khẩu linh kiện trong khu vực",
        "Đóng cửa biên giới các nước"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 协定开创性地确立了原产地累积规则，使得区域内中间品关税壁垒得以瓦解."
    },
    {
      "id": "q2",
      "question_vi": "RCEP mang ý nghĩa địa kinh tế gì trước xu hướng chống toàn cầu hóa?",
      "options_vi": [
        "Làm gia tăng xung đột vũ trang",
        "Cung cấp con hào thể chế đa phương vững chắc bảo vệ sự phồn vinh và hợp tác kinh tế",
        "Ngừng toàn bộ hoạt động xuất nhập khẩu"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 高标准的区域多边规则为亚太经济繁荣筑牢了多边主义的制度护城河."
    },
    {
      "id": "q3",
      "question_vi": "Điểm nhấn đặc thù trong triết lý vận hành của RCEP đối với các nước thành viên là gì?",
      "options_vi": [
        "Chỉ ưu tiên tuyệt đối các nước phát triển giàu có",
        "Nguyên tắc bao trùm và cùng thụ hưởng giúp mọi quốc gia ở trình độ khác nhau đều được chia sẻ lợi ích",
        "Bắt buộc các nước nghèo gánh toàn bộ chi phí"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 包容性与普惠性原则的深入践行，让不同发展梯队国家均能分享红利."
    }
  ]
