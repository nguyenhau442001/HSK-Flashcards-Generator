  "quiz": [
    {
      "id": "q1",
      "question_vi": "Văn kiện đa phương nào là cơ sở pháp lý nền tảng cho hợp tác truy bắt tội phạm tham nhũng toàn cầu?",
      "options_vi": [
        "Hiệp ước Thương mại Hàng hải",
        "Công ước Liên Hợp Quốc về Chống Tham nhũng (UNCAC)",
        "Luật Thể thao Quốc tế"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 依托《联合国反腐败公约》等多边条约框架，开展刑事司法协助与联合行动."
    },
    {
      "id": "q2",
      "question_vi": "Nguyên tắc pháp lý quốc tế nào thường bị các đối tượng phạm tội tham nhũng lợi dụng để trốn tránh dẫn độ?",
      "options_vi": [
        "Nguyên tắc mở cửa biên giới",
        "Nguyên tắc không dẫn độ nếu đối mặt án tử hình, ngoại lệ tội phạm chính trị và rào cản tội danh kép",
        "Quy định đổi tiền ngoại tệ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 死刑不引渡、政治犯不引渡以及双重犯罪原则审查，成为逃避审判的借口."
    },
    {
      "id": "q3",
      "question_vi": "Biện pháp tài chính hữu hiệu để phong tỏa tài sản tham nhũng giấu ở nước ngoài là gì?",
      "options_vi": [
        "Không can thiệp vào tài khoản ngân hàng",
        "Thủ tục tịch thu tài sản bất hợp pháp và truy tìm danh tính người thụ hưởng thực sự (UBO) của dòng tiền",
        "Khuyến khích lập công ty ma"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư và năm viết: 探索违法所得没收程序，穿透识别实际受益人，斩断资金链条."
    }
  ]
