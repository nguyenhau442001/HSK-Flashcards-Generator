  "quiz": [
    {
      "id": "q1",
      "question_vi": "Cơ chế CBAM (Carbon Border Adjustment Mechanism) yêu cầu điều gì đối với hàng hóa nhập khẩu phát thải cao?",
      "options_vi": [
        "Miễn thuế toàn bộ hàng hóa",
        "Mua chứng chỉ carbon để bù đắp chênh lệch giá phát thải giữa nước xuất khẩu và nước nhập khẩu",
        "Cấm xuất khẩu hàng công nghiệp"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 要求就钢铁、铝材等高排放产品购买碳关税凭证，以弥补境内外碳价差额."
    },
    {
      "id": "q2",
      "question_vi": "Mối quan ngại lớn nhất của các quốc gia đang phát triển đối với cơ chế này là gì?",
      "options_vi": [
        "Làm cho giá thép giảm sâu",
        "Nguy cơ biến tướng thành chủ nghĩa bảo hộ thương mại xanh và vi phạm nguyên tắc không phân biệt đối xử của WTO",
        "Không ai muốn mua hàng hóa xanh"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 引发了对绿色贸易保护主义与违背WTO非歧视原则的担忧与法理抗辩."
    },
    {
      "id": "q3",
      "question_vi": "Giải pháp để doanh nghiệp sản xuất xuất khẩu thích ứng với rào cản carbon mới là gì?",
      "options_vi": [
        "Tăng cường đốt thêm than đá",
        "Kiểm toán dấu chân carbon toàn vòng đời sản phẩm và chuyển đổi sang dùng điện sạch, công nghệ luyện kim xanh",
        "Ngừng xuất khẩu"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 加快全生命周期碳足迹核算，倒逼工序全面应用绿电与氢冶金技术."
    }
  ]
}