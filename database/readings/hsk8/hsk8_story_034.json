  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hiện tượng 'tê liệt lập pháp' (regulatory chill) do cơ chế ISDS gây ra là gì?",
      "options_vi": [
        "Nhà nước không muốn thu thuế",
        "Chính phủ các nước sợ bị kiện trọng tài đòi bồi thường hàng tỷ USD nên chùn tay không dám ban hành chính sách bảo vệ môi trường",
        "Các nhà đầu tư không chịu kinh doanh"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 导致东道国在制定保护公共健康与应对气候变化法规时陷入监管寒蝉效应."
    },
    {
      "id": "q2",
      "question_vi": "Điểm bất cập bị chỉ trích kịch liệt nhất trong cơ chế trọng tài ISDS truyền thống là gì?",
      "options_vi": [
        "Thời gian xét xử quá nhanh",
        "Phiên tòa bí mật, không có cấp phúc thẩm để sửa sai và trọng tài viên vừa làm luật sư vừa làm thẩm phán gây xung đột lợi ích",
        "Chi phí nộp đơn quá thấp"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 秘密仲裁程序、缺乏上诉机制以及角色冲突，严重侵蚀了正当性与公信力."
    },
    {
      "id": "q3",
      "question_vi": "Định hướng cải cách tiến bộ mà Liên Hợp Quốc đang thúc đẩy là gì?",
      "options_vi": [
        "Bãi bỏ mọi tòa án trên thế giới",
        "Thành lập Tòa án Đầu tư Đa phương thường trực (Multilateral Investment Court) có cấp phúc thẩm và bảo vệ quyền quản lý công của quốc gia",
        "Chỉ xử cho nhà đầu tư thắng"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 推动设立常设多边投资法院与常设上诉机制，确立国家公共监管权的例外豁免."
    }
  ]
