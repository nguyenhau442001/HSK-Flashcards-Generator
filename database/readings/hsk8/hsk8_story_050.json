  "quiz": [
    {
      "id": "q1",
      "question_vi": "Vì sao Bằng sáng chế Thiết yếu Chuẩn mực (SEP) lại mang quyền lực chi phối to lớn đối với thị trường công nghệ?",
      "options_vi": [
        "Vì bằng sáng chế đó không ai dùng",
        "Vì một khi đã trở thành chuẩn công nghiệp (như 5G), bất kỳ công ty nào muốn sản xuất thiết bị đều bắt buộc phải dùng và không thể né tránh",
        "Vì bằng sáng chế được cấp miễn phí"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 任何企业只要制造符合标准的产品即无法绕开SEP持有人的专利许可."
    },
    {
      "id": "q2",
      "question_vi": "Nguyên tắc cam kết cốt lõi nào ràng buộc chủ sở hữu bằng sáng chế chuẩn mực khi tính phí bản quyền?",
      "options_vi": [
        "Tự do tăng giá bất tận",
        "Nguyên tắc FRAND: Công bằng, Hợp lý và Không phân biệt đối xử (Fair, Reasonable, and Non-Discriminatory)",
        "Cấm tất cả các đối thủ mua bản quyền"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 围绕公平、合理、无歧视（FRAND）许可承诺的费率计算准则."
    },
    {
      "id": "q3",
      "question_vi": "Công cụ pháp lý nào được tòa án các nước ban hành nhằm ngăn cản đối phương khởi kiện ở quốc gia khác trong cuộc chiến SEP?",
      "options_vi": [
        "Lệnh bắt giữ người",
        "Lệnh cấm khởi kiện ở nước ngoài (Anti-Suit Injunction - ASI)",
        "Lệnh tịch thu điện thoại"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 多国法院频繁通过签发禁诉令（Anti-Suit Injunction）剥夺在异国提起诉讼资格."
    }
  ]
