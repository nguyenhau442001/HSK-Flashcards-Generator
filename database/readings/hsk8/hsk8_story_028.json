  "quiz": [
    {
      "id": "q1",
      "question_vi": "Khoảng trống pháp lý lớn nhất đối với người tị nạn do biến đổi khí hậu là gì?",
      "options_vi": [
        "Họ không biết bơi thuyền",
        "Công ước về người tị nạn năm 1951 không công nhận yếu tố thảm họa môi trường là căn cứ cấp quy chế tị nạn",
        "Họ có quá nhiều tiền"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 《难民地位公约》仅将战争或迫害逃亡者定为难民，将环境受害者完全排除在外."
    },
    {
      "id": "q2",
      "question_vi": "Nguy cơ khắc nghiệt nhất mà người dân các quốc đảo trũng thấp đang đối mặt là gì?",
      "options_vi": [
        "Không có cá để ăn",
        "Toàn bộ lãnh thổ đất nước bị nước biển nhấn chìm hoàn toàn, dẫn tới mất tổ quốc và trở thành người không quốc tịch",
        "Nhiệt độ quá lạnh"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 低洼小岛屿国家面临举国被汪洋吞噬的灭顶之灾，制造了前所未有的流民群体."
    },
    {
      "id": "q3",
      "question_vi": "Yêu cầu cấp bách mà cộng đồng quốc tế cần thực hiện đối với người tị nạn khí hậu là gì?",
      "options_vi": [
        "Trục xuất họ về vùng ngập lụt",
        "Xác lập điều ước quốc tế mới về quyền cư trú xuyên biên giới và cơ chế bồi thường tái định cư nhân đạo",
        "Lờ đi coi như không biết"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 确立气候致贫流民的跨境居留权与重安置补偿机制."
    }
  ]
