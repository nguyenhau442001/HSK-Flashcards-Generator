  "quiz": [
    {
      "id": "q1",
      "question_vi": "Vì sao các tập đoàn công nghệ số đa quốc gia trước đây dễ dàng né thuế hàng tỷ USD?",
      "options_vi": [
        "Vì họ không có doanh thu",
        "Họ bán dịch vụ xuyên biên giới mà không cần mở văn phòng trụ sở hữu hình, đồng thời chuyển lợi nhuận sang các thiên đường thuế",
        "Vì các nước quên thu thuế"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 轻资产无实体存在打破了物理常设机构规则，利用无形资产在避税天堂规避税收."
    },
    {
      "id": "q2",
      "question_vi": "Trụ cột 2 (Pillar Two) trong giải pháp cải cách thuế của OECD quy định điều quan trọng gì?",
      "options_vi": [
        "Miễn thuế cho tất cả các công ty",
        "Áp đặt mức thuế thu nhập doanh nghiệp tối thiểu toàn cầu 15% (Global Minimum Tax) để xóa bỏ các thiên đường trốn thuế",
        "Tăng thuế lên 90%"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 设定百分之十五的全球最低企业所得税率底线，宣告恶性竞次时代的终结."
    },
    {
      "id": "q3",
      "question_vi": "Quyền lợi mới nào được trao cho các quốc gia thị trường tiêu thụ theo Trụ cột 1 (Pillar One)?",
      "options_vi": [
        "Không được quyền can thiệp",
        "Được quyền thu một phần thuế đối với lợi nhuận của các siêu tập đoàn công nghệ có người dùng tại nước mình dù họ không đặt trụ sở",
        "Phải trả thêm tiền dịch vụ"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 赋予主要市场所在国在无物理实体情形下分享税收红利的法定权利."
    }
  ]
