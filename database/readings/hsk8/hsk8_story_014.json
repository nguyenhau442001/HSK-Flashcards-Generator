  "quiz": [
    {
      "id": "q1",
      "question_vi": "Lợi thế kinh tế to lớn của hải trình Bắc Cực so với hải trình truyền thống qua kênh đào Suez là gì?",
      "options_vi": [
        "Có nhiều trạm xăng hơn",
        "Rút ngắn quãng đường di chuyển gần một phần ba, tiết kiệm đáng kể thời gian và chi phí vận tải",
        "Nhiệt độ ấm áp hơn"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 东北航道与西北航道能够将传统苏伊士运河航程缩短近三分之一."
    },
    {
      "id": "q2",
      "question_vi": "Nguyên nhân khiến vùng cực trở thành tâm điểm cạnh tranh địa chính trị là gì?",
      "options_vi": [
        "Không có sinh vật sinh sống",
        "Băng tan làm lộ tuyến hàng hải chiến lược cùng kho tàng dầu khí, khoáng sản và tài nguyên biển khổng lồ",
        "Chỉ vì tranh chấp đất nông nghiệp"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 富集的极地油气、关键矿产与渔业资源，引发了激烈的地缘政治角逐."
    },
    {
      "id": "q3",
      "question_vi": "Giải pháp căn bản để ngăn ngừa xung đột quân sự hóa tại Bắc Cực là gì?",
      "options_vi": [
        "Xây dựng căn cứ tên lửa khắp nơi",
        "Tôn trọng luật pháp quốc tế, coi vùng cực là di sản chung nhân loại và tăng cường hợp tác nghiên cứu khoa học đa phương",
        "Bỏ rơi vùng cực"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu kết nêu rõ: 将极地视为全人类共同继承财产，避免极地军事化冲突."
    }
  ]
