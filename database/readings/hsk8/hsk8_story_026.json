  "quiz": [
    {
      "id": "q1",
      "question_vi": "Cốt lõi tranh chấp bản quyền lớn nhất giữa các nghệ sĩ và công ty AI hiện nay là gì?",
      "options_vi": [
        "Giá bán tranh quá đắt",
        "Tự ý thu thập hàng triệu tác phẩm có bản quyền làm dữ liệu huấn luyện mô hình mà không xin phép hay trả phí",
        "Chất lượng hình ảnh AI quá xấu"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 未经创作者授权抓取海量作品用于模型训练，引发了全球创作者的集体诉讼."
    },
    {
      "id": "q2",
      "question_vi": "Vì sao quy tắc 'tiếp cận + tương đồng thực chất' truyền thống gặp khó khăn khi xử lý AI?",
      "options_vi": [
        "Vì tòa án không có thẩm phán",
        "Vì mạng nơ-ron phân rã kiến thức thành các trọng số toán học phức tạp chứ không sao chép nguyên xi một bức tranh cụ thể",
        "Vì nghệ sĩ không muốn ra tòa"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 传统侵权认定规则在面对神经网络黑箱生成的碎片化重组时陷入失灵."
    },
    {
      "id": "q3",
      "question_vi": "Giải pháp thể chế được đề xuất để giải quyết bế tắc bản quyền AI là gì?",
      "options_vi": [
        "Cấm hoàn toàn việc dùng máy tính",
        "Xây dựng cơ chế cấp phép tập thể theo luật (Statutory Collective Licensing) và tem truy xuất nguồn gốc dữ liệu",
        "Để các công ty công nghệ tự do dùng miễn phí mãi mãi"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 构建法定集体许可机制与建立训练集溯源水印标准，是可行出路."
    }
  ]
