  "topic": "health_daily",
  "estimatedMinutes": 3,
  "description_vi": "Tiểu Minh cảm thấy không khỏe và đến bệnh viện gặp bác sĩ khám bệnh.",
  "sentences": [
    {
      "id": "s1",
      "zh": "今天早上我觉得身体不舒服。",
