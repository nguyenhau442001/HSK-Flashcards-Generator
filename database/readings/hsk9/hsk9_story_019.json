  "quiz": [
    {
      "id": "q1",
      "question_vi": "Luận điểm nền tảng của Saussure về mối quan hệ giữa 'Cái biểu đạt' và 'Cái được biểu đạt' là gì?",
      "options_vi": [
        "Có mối liên hệ tự nhiên bắt buộc",
        "Mối liên hệ giữa âm thanh chữ viết và khái niệm mang tính võ đoán ngẫu nhiên (Arbitrary), dựa trên quy ước xã hội",
        "Chữ viết sinh ra trước thế giới"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 确立了能指与所指之间任意性联系的符号学原理."
    },
    {
      "id": "q2",
      "question_vi": "Khái niệm 'Différance' (Trì hoãn khác biệt) của Jacques Derrida mang ý nghĩa triết học gì?",
      "options_vi": [
        "Mọi từ ngữ đều có một nghĩa duy nhất cố định",
        "Ý nghĩa không bao giờ cố định ngay lập tức tại một điểm mà luôn trôi dạt và bị trì hoãn vô tận trong chuỗi ký hiệu",
        "Cấm đọc sách"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 能指的链条永远在文本游戏中漂移延宕，终极意义被无限期推迟."
    },
    {
      "id": "q3",
      "question_vi": "Tuyên ngôn 'Cái chết của tác giả' của Roland Barthes khẳng định điều gì?",
      "options_vi": [
        "Tác giả cuốn sách đã qua đời về mặt sinh học",
        "Ý nghĩa của văn bản không bị trói buộc bởi ý định chủ quan của tác giả ban đầu, mà mở ra cho sự đồng sáng tạo của người đọc",
        "Không ai được viết sách nữa"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 文本意义的阐释主权从作者彻底让渡给读者无尽的能动重构."
    }
  ]
