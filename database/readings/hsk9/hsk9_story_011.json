  "quiz": [
    {
      "id": "q1",
      "question_vi": "Luận chứng 'Không có phép lạ' (No-Miracles Argument) ủng hộ thuyết hiện thực khoa học như thế nào?",
      "options_vi": [
        "Khoa học dựa vào bùa chú",
        "Nếu các thực thể vi mô không có thật, sự thành công rực rỡ và chính xác đến kinh ngạc của công nghệ hiện đại sẽ là phép lạ không thể giải thích nổi",
        "Khoa học luôn sai lầm"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 倘若微观客体并非真实存在，则现代技术的辉煌成就将沦为不可思议的奇迹."
    },
    {
      "id": "q2",
      "question_vi": "Luận điểm 'Quy nạp siêu hình bi quan' (Pessimistic Meta-Induction) của phe phản hiện thực dựa trên cơ sở nào?",
      "options_vi": [
        "Các nhà khoa học không trung thực",
        "Trong lịch sử khoa học có rất nhiều lý thuyết từng được coi là đúng đắn nhưng sau đó đã bị chứng minh là sai và bị đào thải",
        "Toán học không đáng tin"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 援引悲观元归纳论点，指出史上诸多曾被奉为真理的理论实体皆最终被证伪."
    },
    {
      "id": "q3",
      "question_vi": "Quan điểm cốt lõi của 'Thuyết hiện thực cấu trúc' (Structural Realism) là gì?",
      "options_vi": [
        "Vật chất không hề tồn tại",
        "Thứ bảo tồn liên tục qua các cuộc cách mạng khoa học chính là cấu trúc quan hệ toán học của thực tại vật lý chứ không phải bản chất thực thể",
        "Mọi lý thuyết đều như nhau"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 真正得以长存传承的并非实体本质，而是描述实在的客观数学关系结构."
    }
  ]
