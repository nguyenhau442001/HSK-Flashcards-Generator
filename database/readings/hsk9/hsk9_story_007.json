  "quiz": [
    {
      "id": "q1",
      "question_vi": "Quy chế pháp lý của vùng đáy biển quốc tế theo UNCLOS là gì?",
      "options_vi": [
        "Tài sản riêng của quốc gia tìm thấy trước",
        "Di sản chung của toàn thể nhân loại",
        "Khu vực không có pháp luật"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 庄严确立为全人类共同继承财产."
    },
    {
      "id": "q2",
      "question_vi": "Mối lo ngại sinh thái lớn nhất khi tiến hành khai thác mỏ dưới đáy biển sâu là gì?",
      "options_vi": [
        "Làm bão lũ nhiều hơn trên bờ",
        "Gây thảm họa hủy diệt không thể phục hồi đối với hệ sinh thái đáy biển sâu",
        "Làm nước biển ấm lên ngay lập tức"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 对极其脆弱的深海冷泉热液生态系统造成不可逆转的灭顶之灾."
    },
    {
      "id": "q3",
      "question_vi": "Nguyên tắc cốt lõi để bảo đảm công lý đại dương trong quản trị biển là gì?",
      "options_vi": [
        "Khai thác tối đa chia tiền ngay",
        "Công bằng giữa các thế hệ và nguyên tắc thận trọng sinh thái",
        "Bỏ qua ý kiến của các nước đang phát triển"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 在代际公平与生态审慎原则指导下，审慎对待开采决策."
    }
  ]
