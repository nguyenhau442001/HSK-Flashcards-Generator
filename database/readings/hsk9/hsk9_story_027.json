  "quiz": [
    {
      "id": "q1",
      "question_vi": "Nghịch lý đo lường lượng tử (Quantum Measurement Problem) nảy sinh từ mâu thuẫn căn bản nào?",
      "options_vi": [
        "Do máy đo bị hỏng",
        "Mâu thuẫn giữa sự tiến hóa trơn tru liên tục của phương trình Schrödinger và sự sụp đổ ngắt quãng đột ngột của hàm sóng khi có người quan sát",
        "Do hạt photon chuyển động quá nhanh"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 确定性线性酉演化，在遭遇宏观测量的波函数神秘坍缩时暴露出深刻的理论割裂."
    },
    {
      "id": "q2",
      "question_vi": "Luận điểm cốt lõi của 'Cách diễn giải Đa thế giới' (Many-Worlds Interpretation - MWI) của Hugh Everett là gì?",
      "options_vi": [
        "Không có nguyên tử nào tồn tại",
        "Hàm sóng chưa bao giờ sụp đổ; vũ trụ liên tục phân nhánh thành vô số thế giới song song độc lập hiện thực hóa mọi xác suất lượng tử",
        "Con mèo chỉ là hình vẽ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 主张波函数从未发生物理坍缩，退相干机制下持续向多重平行现实分支演进."
    },
    {
      "id": "q3",
      "question_vi": "Cơ chế vật lý nào giải thích tại sao chúng ta ở một nhánh lại không thể nhìn thấy hay cảm nhận được các nhánh thế giới song song khác?",
      "options_vi": [
        "Do mắt người bị cận thị",
        "Cơ chế giải kết hợp lượng tử (Quantum Decoherence) triệt tiêu hoàn toàn sự giao thoa pha giữa các nhánh hiện thực vĩ mô",
        "Do khoảng cách không gian quá xa"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 在退相干机制的作用下持续且不可逆地向多重平行现实分支演进."
    }
  ]
}