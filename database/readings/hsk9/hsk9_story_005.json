  "quiz": [
    {
      "id": "q1",
      "question_vi": "Học thuyết 'Sự giảo quyệt của lý tính' của Hegel hàm ý điều gì?",
      "options_vi": [
        "Lịch sử không có quy luật nào",
        "Lý tính lịch sử mượn các hành vi và đam mê của cá nhân để hiện thực hóa mục tiêu chung",
        "Mọi người đều hành động hoàn toàn vị tha"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 历史理性借由个体盲目的激情与私欲，最终达成宏大目标."
    },
    {
      "id": "q2",
      "question_vi": "Mặt trái nguy hiểm nếu tuyệt đối hóa thuyết tất định trong lịch sử là gì?",
      "options_vi": [
        "Bóp nghẹt trách nhiệm đạo đức và sự lựa chọn tự do của cá nhân",
        "Làm cho xã hội tiến bộ quá nhanh",
        "Khiến con người trở nên quá lạc quan"
      ],
      "answer": 0,
      "explanation_vi": "Trong câu có viết: 极易扼杀个体在重大历史关头的道德责任与自由抉择."
    },
    {
      "id": "q3",
      "question_vi": "Tư tưởng của Kant về lý tính thực hành khẳng định điều gì?",
      "options_vi": [
        "Con người hoàn toàn là nô lệ của hoàn cảnh",
        "Mệnh lệnh đạo đức trao cho con người năng lực vượt lên nhân quả để tự lập giá trị",
        "Lịch sử là một vòng tuần hoàn bế tắc"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 坚信道德律令赋予了人类超越经验因果必然、自主确立价值的能力."
