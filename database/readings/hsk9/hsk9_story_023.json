  "quiz": [
    {
      "id": "q1",
      "question_vi": "Quan điểm mang tính bước ngoặt của Wittgenstein thời kỳ sau về 'ý nghĩa của ngôn ngữ' là gì?",
      "options_vi": [
        "Ý nghĩa là ý nghĩ trong đầu tác giả",
        "Ý nghĩa chính là cách dùng trong các hình thái đời sống cụ thể (Meaning is use in a form of life)",
        "Mỗi từ chỉ có một nghĩa cố định bất biến"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 语言的意义绝非指向抽象实体，而根本上在于它在生活形式中的实际用法."
    },
    {
      "id": "q2",
      "question_vi": "Khái niệm 'Tính tương đồng gia đình' (Family Resemblance) phản bác thuyết bản chất luận như thế nào?",
      "options_vi": [
        "Mọi thành viên trong nhà phải giống hệt nhau",
        "Không có một đặc điểm cốt lõi duy nhất nào chia sẻ cho tất cả đối tượng, mà chỉ có một mạng lưới các nét tương đồng đan cài",
        "Tất cả các khái niệm đều vô nghĩa"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 击碎了对单一共同本质的执迷，事物之间仅存在交错重叠的相似网络."
    },
    {
      "id": "q3",
      "question_vi": "Theo Wittgenstein, nhiệm vụ đích thực của 'Triết học trị liệu' là gì?",
      "options_vi": [
        "Sáng tạo ra các hệ thống siêu hình học trừu tượng mới",
        "Chữa lành các chứng rối loạn tư duy do lạm dụng ngôn ngữ sai ngữ cảnh, đưa từ ngữ từ siêu hình học trở về với đời sống thường nhật",
        "Dạy ngữ pháp cho trẻ em"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 哲学的治疗任务就在于将词语从形而上学召回日常用法."
    }
  ]
