  "quiz": [
    {
      "id": "q1",
      "question_vi": "Vì sao các định luật vi mô đối xứng theo thời gian nhưng thế giới vĩ mô lại có 'mũi tên thời gian' (Arrow of Time) một chiều?",
      "options_vi": [
        "Do đồng hồ chạy một chiều",
        "Do Định luật 2 nhiệt động lực học: entropy (độ hỗn loạn) của hệ cô lập luôn có xu hướng tăng theo xác suất thống kê",
        "Do Trái Đất quay quanh Mặt Trời"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 热力学第二定律断言孤立系统总熵永不减少，本质是向高概率态跃迁的统计必然."
    },
    {
      "id": "q2",
      "question_vi": "Điều kiện ban đầu tối quan trọng nào của Big Bang cho phép sự sống và các tiến trình lịch sử diễn ra?",
      "options_vi": [
        "Vũ trụ ban đầu có entropy cực đại",
        "Trạng thái khởi thủy của vũ trụ sở hữu mức entropy cực kỳ thấp (Past Hypothesis)",
        "Nhiệt độ ban đầu bằng 0 tuyệt đối"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 宇宙早期的极低熵初始状态构成了一切宏观不可逆过程的最终物理源泉."
    },
    {
      "id": "q3",
      "question_vi": "Khái niệm 'Cái chết nhiệt của vũ trụ' (Heat Death) miêu tả kịch bản tương lai nào?",
      "options_vi": [
        "Vũ trụ bốc cháy thành ngọn lửa",
        "Vũ trụ giãn nở vô tận, tất cả các ngôi sao tắt lịm, nhiệt độ san bằng đồng đều và không còn bất kỳ năng lượng tự do nào để sinh công",
        "Vũ trụ sụp đổ thành một điểm"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 终将在遥远未来滑向所有能量温差被抚平的热寂终局."
    }
  ]
