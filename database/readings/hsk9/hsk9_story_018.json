  "quiz": [
    {
      "id": "q1",
      "question_vi": "Đặc tính then chốt của một mạng lưới 'Phi quy mô' (Scale-Free Network) là gì?",
      "options_vi": [
        "Mọi nút đều có số lượng kết nối giống hệt nhau",
        "Phân bố kết nối tuân theo quy luật số mũ lũy thừa (Power Law): đa số nút có ít kết nối, nhưng có một số ít nút trung tâm (Hubs) nắm giữ lượng kết nối khổng lồ",
        "Mạng lưới không có kết nối nào"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 节点度分布服从长尾幂律分布，系统中普遍存在连接度极高的极少数枢纽节点."
    },
    {
      "id": "q2",
      "question_vi": "Cơ chế 'Kết nối ưu tiên' (Preferential Attachment) giải thích điều gì?",
      "options_vi": [
        "Hiện tượng người nghèo giàu lên",
        "Quy luật 'kẻ giàu càng giàu hơn': các nút mạng mới khi gia nhập luôn có xu hướng kết nối vào các nút đã có sẵn nhiều liên kết nhất",
        "Mạng lưới tự ngắt kết nối ngẫu nhiên"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 富者愈富的优先连接机制，使新节点天然倾向于优先连接拥有大量连接的核心节点."
    },
    {
      "id": "q3",
      "question_vi": "Điểm yếu chí mạng của mạng phi quy mô là gì?",
      "options_vi": [
        "Dễ bị sập nếu hỏng vài máy tính ngẫu nhiên",
        "Rất bền bỉ trước lỗi ngẫu nhiên, nhưng cực kỳ dễ sụp đổ toàn bộ hệ thống nếu các nút đầu não trung tâm bị tấn công chính xác",
        "Không có bất kỳ nhược điểm nào"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 对抗随机故障极高鲁棒，但在遭遇针对关键枢纽节点的蓄意攻击时暴露出致命脆弱."
    }
  ]
