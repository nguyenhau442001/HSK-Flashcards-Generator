  "quiz": [
    {
      "id": "q1",
      "question_vi": "Khái niệm 'Qualia' (phẩm chất cảm nhận) trong triết học tâm trí dùng để chỉ điều gì?",
      "options_vi": [
        "Tốc độ truyền xung thần kinh",
        "Đặc tính trải nghiệm chủ quan sống động ở ngôi thứ nhất (như cảm giác đau đớn, vị ngọt, màu đỏ cảm nhận được)",
        "Khả năng ghi nhớ số liệu"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 感受质作为个体主观体验的第一人称质的特征，构成了意识难题核反应堆."
    },
    {
      "id": "q2",
      "question_vi": "Khái niệm 'Khoảng cách giải thích' (Explanatory Gap) của Joseph Levine muốn nói lên điều gì?",
      "options_vi": [
        "Bộ não con người quá nhỏ",
        "Không thể giải thích logic thỏa đáng tại sao các phản ứng hóa học vật lý nơ-ron lại sinh ra được cảm xúc chủ quan",
        "Máy móc thông minh hơn con người"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 神经元放电与主观感受到的那一抹红色之间存在着无法跨越的逻辑鸿沟."
    },
    {
      "id": "q3",
      "question_vi": "Thí nghiệm tư duy 'Zombie triết học' (Philosophical Zombie) chứng minh luận điểm gì?",
      "options_vi": [
        "Xác sống có thật ngoài đời",
        "Cấu trúc vật lý của cơ thể không tự động giải thích hay tất yếu kéo theo sự tồn tại của ý thức chủ quan",
        "Con người không cần ngủ"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 物理结构上与常人同一但缺乏内在体验的存在物在逻辑上完全自洽."
    }
  ]
}