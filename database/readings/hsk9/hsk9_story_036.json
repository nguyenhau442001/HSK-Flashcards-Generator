  "quiz": [
    {
      "id": "q1",
      "question_vi": "Theo Karl Popper, tiêu chuẩn duy nhất để phân biệt giữa 'Khoa học' và 'Giả khoa học' (tiêu chuẩn phân giới) là gì?",
      "options_vi": [
        "Lý thuyết đó có nhiều người tin hay không",
        "Tính có thể bị bác bẻ (Falsifiability - 可证伪性): lý thuyết phải đưa ra các dự đoán rõ ràng dám chịu rủi ro bị thực nghiệm bác bỏ",
        "Lý thuyết đó có viết thành sách hay không"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 确立了可证伪性作为科学与非科学的划界标准：在原则上存在被事实证伪的风险，才具备资格."
    },
    {
      "id": "q2",
      "question_vi": "Ví dụ 'Thiên nga đen' (Black Swan) minh họa nhược điểm chí mạng của phương pháp nào?",
      "options_vi": [
        "Phương pháp suy luận diễn dịch toán học",
        "Phương pháp quy nạp (Induction): dù quan sát 1 triệu con thiên nga trắng cũng không thể bảo đảm chắc chắn con thiên nga tiếp theo không phải màu đen",
        "Phương pháp phỏng vấn ý kiến"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 无论此前观察到数百万计白天鹅，逻辑上也绝无法推导出一只黑天鹅不存在."
    },
    {
      "id": "q3",
      "question_vi": "Bản chất của tri thức khoa học theo góc nhìn của Popper là gì?",
      "options_vi": [
        "Là chân lý vĩnh cửu bất biến không bao giờ sai",
        "Là chuỗi những phỏng đoán táo bạo và phản bác ngặt nghèo (Conjectures and Refutations), tất cả lý thuyết đều là giả thuyết chưa bị bác bỏ",
        "Là niềm tin tôn giáo tuyệt đối"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 科学演进是一场大胆猜想与严苛反驳的历程，所拥有的尽皆是尚未被推翻的暂时假说."
    }
  ]
}