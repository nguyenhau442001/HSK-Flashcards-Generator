  "quiz": [
    {
      "id": "q1",
      "question_vi": "Nghịch lý 'Quỷ Maxwell' (Maxwell's Demon) trong vật lý tưởng tượng ra tình huống vi phạm định luật nào?",
      "options_vi": [
        "Vi phạm định luật vạn vật hấp dẫn",
        "Vi phạm Định luật 2 nhiệt động lực học bằng cách tự phát tách phân tử nóng và lạnh để giảm entropy mà không cần tiêu tốn công",
        "Vi phạm định luật bảo toàn động lượng"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 实现了无需做功而自发制造温差的逆熵奇迹，发起了致命诘问."
    },
    {
      "id": "q2",
      "question_vi": "Nguyên lý Landauer (Landauer's Principle) đã giải cứu Định luật 2 nhiệt động lực học bằng phát hiện vật lý nào?",
      "options_vi": [
        "Chứng minh quỷ Maxwell không có thật",
        "Chứng minh 'thông tin là vật lý' (Information is physical): hành vi xóa một bit thông tin khỏi bộ nhớ bắt buộc phải tỏa ra một lượng nhiệt tối thiểu k*T*ln(2) vào môi trường",
        "Chứng minh máy tính không bao giờ nóng lên"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 擦除一比特物理信息，必然在环境中不可逆地释放至少kT乘以自然对数二的耗散废热."
    },
    {
      "id": "q3",
      "question_vi": "Kết luận triết học sâu sắc rút ra từ việc giải mã nghịch lý Quỷ Maxwell là gì?",
      "options_vi": [
        "Nhiệt học và thông tin không liên quan gì nhau",
        "Thông tin và entropy nhiệt động lực học có sự thống nhất bản thể sâu sắc, và việc xử lý thông tin luôn bị trói buộc bởi các định luật vật lý cơ bản",
        "Máy vĩnh cửu có thể chế tạo được"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ sáu viết: 信息与热力学熵在物理本体层面的深刻统一，将人类引向物理宇宙即信息计算的殿堂."
    }
  ]
