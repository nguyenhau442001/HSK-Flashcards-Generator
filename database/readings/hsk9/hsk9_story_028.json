  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hiện tượng 'Tha hóa lao động' (Alienation of Labor) dưới chủ nghĩa tư bản theo Karl Marx biểu hiện như thế nào?",
      "options_vi": [
        "Công nhân được tự do tuyệt đối",
        "Sản phẩm do công nhân làm ra quay lại thống trị, nô dịch công nhân và biến lao động thành khổ sai thay vì sự sáng tạo tự do tự giác",
        "Mọi người đều không muốn làm việc"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 机器大工业反噬蜕变为将工人降格为机器附庸，劳动不再是自觉生命活动而沦为苦役."
    },
    {
      "id": "q2",
      "question_vi": "Trong 'Mảnh đoạn về máy móc' (Fragment on Machines), Marx đã tiên đoán điều gì về tự động hóa?",
      "options_vi": [
        "Máy móc sẽ thống trị và tiêu diệt loài người",
        "Sự phát triển tột bậc của tự động hóa và tri thức xã hội (General Intellect) sẽ giảm thiểu lao động trực tiếp, mở đường cho sự sụp đổ của logic bóc lột thặng dư",
        "Nhân loại sẽ quay lại thời kỳ đồ đá"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 自动化机器体系使直接劳动不再是决定要素，普遍智慧转化为生产力将敲响丧钟."
    },
    {
      "id": "q3",
      "question_vi": "Mục tiêu tối thượng của 'Vương quốc tự do' (Realm of Freedom) đối với con người là gì?",
      "options_vi": [
        "Lười biếng suốt ngày không làm gì",
        "Thời gian rảnh rỗi tự do được giải phóng khỏi lao động tất yếu để mỗi cá nhân phát triển tự do, toàn diện về trí tuệ, nghệ thuật và nhân cách",
        "Xây dựng thêm nhiều nhà tù"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối nhấn mạnh: 让节约下来的广阔自由时间真正转化为每个人全面而自由发展的永恒沃土."
    }
  ]
