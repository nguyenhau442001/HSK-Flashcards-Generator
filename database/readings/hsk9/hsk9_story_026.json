  "quiz": [
    {
      "id": "q1",
      "question_vi": "Nguyên tắc cốt lõi 'nhạy với chí hướng nhưng trơ với thiên phú' (敏于志向而钝于禀赋) của Dworkin nghĩa là gì?",
      "options_vi": [
        "Không quan tâm đến người nghèo",
        "Chính sách xã hội cần tôn trọng và phản ánh các lựa chọn hoài bão cá nhân nhưng phải xóa bỏ và bù đắp cho những bất công do thiên phú bẩm sinh ngẫu nhiên tạo ra",
        "Mọi người phải hưởng phúc lợi bằng nhau bất kể lười biếng"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 提出了敏于志向而钝于禀赋的资源平等论核心框架."
    },
    {
      "id": "q2",
      "question_vi": "Tiêu chuẩn 'Kiểm tra ghen tị' (Envy Test) trong cuộc đấu giá đảo hoang được thỏa mãn khi nào?",
      "options_vi": [
        "Khi tất cả mọi người cùng nghèo",
        "Khi cuộc đấu giá hoàn tất và không một ai trong xã hội muốn đổi gói tài nguyên của mình lấy gói tài nguyên của người khác",
        "Khi người giàu mua hết tài sản"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 通过自由竞价直至无人嫉妒他人的资源组合时达成嫉妒检验."
    },
    {
      "id": "q3",
      "question_vi": "Cơ chế 'Thị trường bảo hiểm giả định' (Hypothetical Insurance Market) nhằm giải quyết vấn đề gì?",
      "options_vi": [
        "Bảo hiểm cháy nổ nhà cửa",
        "Thiết lập mức thuế và tái phân phối phúc lợi công bằng để bù đắp cho những người sinh ra chịu rủi ro bẩm sinh (khuyết tật, hoàn cảnh bất hạnh)",
        "Bán bảo hiểm nhân thọ kiếm lời"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 对于原生运气的巨大不公，设计了假想保险市场机制实施合理的税收补偿转移."
    }
  ]
