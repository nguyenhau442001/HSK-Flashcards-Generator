  "quiz": [
    {
      "id": "q1",
      "question_vi": "Bức xạ phông vi sóng vũ trụ (CMB) được hình thành vào thời điểm nào trong lịch sử vũ trụ?",
      "options_vi": [
        "Vừa mới xuất hiện hôm qua",
        "Khoảng 380.000 năm sau Big Bang khi nhiệt độ vũ trụ hạ xuống để electron kết hợp với proton và photon được giải phóng tự do",
        "Khi các vì sao chết đi"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 是大爆炸发生约三十八万年后光子退耦时遗留给理论物理学的宇宙化石."
    },
    {
      "id": "q2",
      "question_vi": "Giả thuyết lạm phát vũ trụ (Cosmic Inflation) của Alan Guth giải quyết nan đề gì?",
      "options_vi": [
        "Giải thích vì sao Trái Đất có nước",
        "Giải quyết nan đề chân trời và độ phẳng bằng giai đoạn giãn nở hàm mũ siêu tốc trong tích tắc đầu tiên của vũ trụ",
        "Chứng minh vũ trụ đứng yên"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 早期暴胀假说指出，曾发生过空间尺度以指数级超越光速暴涨的创生阶段."
    },
    {
      "id": "q3",
      "question_vi": "Nguồn gốc ban đầu của các thiên hà và cụm thiên hà trong vũ trụ bắt nguồn từ đâu?",
      "options_vi": [
        "Do bụi nhân tạo tích tụ",
        "Do các thăng giáng lượng tử chân không vi mô bị kéo giãn thành các vùng mật độ vật chất chênh lệch trong thời kỳ lạm phát",
        "Do các mảnh thiên thạch va chạm ngẫu nhiên"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 将量子真空涨落拉伸并冻结为宏观微扰，成为日后星系孕育的种子."
    }
  ]
