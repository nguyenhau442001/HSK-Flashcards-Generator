  "quiz": [
    {
      "id": "q1",
      "question_vi": "Khái niệm 'Khung sườn' (Gestell) của Martin Heidegger phê phán bản chất nào của công nghệ hiện đại?",
      "options_vi": [
        "Công nghệ làm con người lười biếng",
        "Công nghệ nhìn vạn vật và con người như những nguồn nguyên liệu dự trữ (Standby Reserve) sẵn sàng bị khai thác bóc lột",
        "Công nghệ giá quá rẻ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 警示现代技术已将整个自然界乃至人类自身降格为备置物料."
    },
    {
      "id": "q2",
      "question_vi": "Trong lý thuyết hậu hiện tượng học của Don Ihde, 'Quan hệ nhập thể' là gì?",
      "options_vi": [
        "Công nghệ trở thành kẻ thù của con người",
        "Công nghệ trở nên vô hình, hòa nhập làm một và trở thành phần mở rộng tự nhiên của giác quan con người",
        "Người máy cấy vào cơ thể"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 具身关系中技术化身为身体感官的透明延伸，如眼镜与盲杖."
    },
    {
      "id": "q3",
      "question_vi": "Nhận định triết học sâu sắc về 'tính trung lập của công nghệ' là gì?",
      "options_vi": [
        "Công nghệ hoàn toàn vô tội và trung lập",
        "Công nghệ không bao giờ trung lập; nó luôn chủ động khuếch đại một số khía cạnh trải nghiệm đồng thời che lấp những khía cạnh hiện sinh khác",
        "Công nghệ là ma quỷ"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 技术绝非单纯中立工具，在展现某些维度的同时不可避免地隐匿了其他维度."
    }
  ]
}