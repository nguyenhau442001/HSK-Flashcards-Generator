  "quiz": [
    {
      "id": "q1",
      "question_vi": "Ý tưởng cách mạng căn bản nhất của Thuyết siêu dây (Superstring Theory) là gì?",
      "options_vi": [
        "Hạt cơ bản là những quả cầu sắt",
        "Vật chất cơ bản không phải các hạt điểm không chiều mà là các sợi dây năng lượng rung động với các tần số khác nhau",
        "Vũ trụ chỉ có một chiều duy nhất"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 假定宇宙一切物质皆源于一维微观能量弦的不同振动模式."
    },
    {
      "id": "q2",
      "question_vi": "Tại sao thuyết dây lại đòi hỏi không gian phải có tới 10 hoặc 11 chiều?",
      "options_vi": [
        "Để vẽ tranh cho đẹp",
        "Để bảo đảm tính tự nhất quán về mặt toán học và triệt tiêu các phân kỳ lượng tử vô hạn",
        "Vì người ta thích con số 11"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 消除数学发散矛盾，理论严密要求时空必须具备十维或十一维额外卷缩维度."
    },
    {
      "id": "q3",
      "question_vi": "Khái niệm 'Đa tạp Calabi-Yau' có vai trò gì trong vật lý thuyết dây?",
      "options_vi": [
        "Là tên một hành tinh xa xôi",
        "Là dạng hình học không gian cuộn lại của các chiều bổ sung, quyết định trực tiếp tính chất hạt và các định luật vật lý quan sát được",
        "Một loại máy gia tốc hạt"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 卡拉比-丘流形致密卷缩，其拓扑几何形状决定了物理定律与粒子质量."
    }
  ]
