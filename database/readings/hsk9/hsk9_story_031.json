  "quiz": [
    {
      "id": "q1",
      "question_vi": "Quan điểm căn bản của 'Thuyết quy giản mạnh' (Strong Reductionism) trong sinh học là gì?",
      "options_vi": [
        "Sinh học không có liên hệ gì với vật lý",
        "Toàn bộ hiện tượng sống, tiến hóa và ý thức con người đều có thể giải thích và quy giản về các định luật vật lý hóa học của các phân tử vi mô",
        "Sự sống là một linh hồn vô hình"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 宣称只要完全阐明了基本物理粒子，生物界的演化与心智便能在原则上全盘推导."
    },
    {
      "id": "q2",
      "question_vi": "Hiện tượng 'Trồi hiện' (Emergence - 涌现) trong hệ thống sống được hiểu như thế nào?",
      "options_vi": [
        "Các phần tử biến mất",
        "Khi các bộ phận kết hợp lại thành một hệ thống phức hợp, sẽ xuất hiện những đặc tính hoàn toàn mới (tổng thể lớn hơn phép cộng các bộ phận) mà từng phần tử đơn lẻ không có",
        "Tất cả các tế bào đều giống hệt nhau"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 涌现主义指出，在系统层级跨越中，持续发生着整体大于部分之和的质变跳跃."
    },
    {
      "id": "q3",
      "question_vi": "Khái niệm 'Nhân quả hướng xuống' (Downward Causation - 下向因果) có ý nghĩa gì?",
      "options_vi": [
        "Vật chất rơi từ trên cao xuống",
        "Cấu trúc vĩ mô của toàn bộ hệ thống sinh học có thể tác động ngược trở lại, kiểm soát và điều phối hành vi của các phân tử vi mô bên dưới",
        "Chỉ có vi mô quyết định vĩ mô"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 确立了系统宏观状态能够对底层微观组成成分施加全局性因果约束的反向权力."
    }
  ]
}