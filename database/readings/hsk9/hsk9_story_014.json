  "quiz": [
    {
      "id": "q1",
      "question_vi": "Định lý Bất toàn thứ nhất của Gödel đã chứng minh chân lý logic học nào?",
      "options_vi": [
        "Mọi bài toán đều giải được bằng máy tính",
        "Trong bất kỳ hệ tiên đề hình thức nhất quán nào, luôn tồn tại những mệnh đề đúng nhưng không thể chứng minh được bên trong hệ đó",
        "Toán học hoàn toàn vô dụng"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 任何无矛盾的形式公理系统，必定存在着系统内部不可判定的真命题."
    },
    {
      "id": "q2",
      "question_vi": "Kế hoạch hình thức hóa toán học của nhà toán học vĩ đại nào đã bị định lý Gödel bác bỏ?",
      "options_vi": [
        "Chương trình của David Hilbert (希尔伯特)",
        "Định lý của Pythagoras",
        "Hình học của Euclid"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 希尔伯特企图建立完全又无矛盾的形式化数学公理大厦的梦想被粉碎."
    },
    {
      "id": "q3",
      "question_vi": "Ý nghĩa triết học sâu sắc nhất của định lý Gödel đối với nhận thức luận nhân loại là gì?",
      "options_vi": [
        "Con người không thể biết gì cả",
        "Khái niệm chân lý rộng lớn hơn khái niệm chứng minh hình thức, và trí tuệ trực giác con người không thể bị thay thế hoàn toàn bởi máy móc cơ học",
        "Toán học sẽ biến mất"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm viết: 揭示出真理的范畴远比可证明性宽广，人类直觉永远无法被图灵机穷尽."
    }
  ]
}