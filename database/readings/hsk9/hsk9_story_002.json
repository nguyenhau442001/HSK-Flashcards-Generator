  "quiz": [
    {
      "id": "q1",
      "question_vi": "Đặc tính của chân trời sự kiện (Event Horizon) xung quanh lỗ đen là gì?",
      "options_vi": [
        "Cho phép ánh sáng tự do ra vào",
        "Là đường ranh giới một chiều mà không vật chất hay ánh sáng nào thoát ra được",
        "Nhiệt độ rất thấp"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 事件视界是任何物质与光线都无法逃逸的单向边界."
    },
    {
      "id": "q2",
      "question_vi": "Điều gì xảy ra với các định luật vật lý tại điểm kỳ dị của lỗ đen?",
      "options_vi": [
        "Hoạt động chuẩn xác hơn bình thường",
        "Toàn bộ định luật vật lý hiện hành đều mất hiệu lực",
        "Không có ảnh hưởng gì"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 现有的经典物理定律在此处全盘失效."
    },
    {
      "id": "q3",
      "question_vi": "Mục tiêu tối thượng của các nhà vật lý khi nghiên cứu lỗ đen là gì?",
      "options_vi": [
        "Tìm ra lý thuyết hấp dẫn lượng tử thống nhất vũ trụ",
        "Để chế tạo vũ khí mới",
        "Khai thác đá trên lỗ đen"
      ],
      "answer": 0,
      "explanation_vi": "Trong câu cuối có viết: 通往统一量子引力理论终极梦想的关键钥匙."
    }
  ]
