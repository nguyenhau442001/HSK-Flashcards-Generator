  "quiz": [
    {
      "id": "q1",
      "question_vi": "Luận điểm nổi tiếng của Konrad Lorenz về các 'khuôn khổ tiên nghiệm' của Kant theo góc nhìn sinh học tiến hóa là gì?",
      "options_vi": [
        "Kant hoàn toàn sai lầm",
        "Những gì là 'tiên thiên' (tiên nghiệm) đối với từng cá nhân sinh ra, thực chất chính là kết quả 'hậu thiên' được chọn lọc tự nhiên đúc kết qua hàng triệu năm tiến hóa của giống loài người",
        "Bộ não không hề tiến hóa"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 先验认知范畴并非神秘神赐，本质是物种在系统发育史中经受自然选择所沉淀的适应器官."
    },
    {
      "id": "q2",
      "question_vi": "Khái niệm 'Thế giới 3' (World 3) của Karl Popper dùng để chỉ thế giới nào?",
      "options_vi": [
        "Thế giới các hành tinh xa xôi",
        "Thế giới các sản phẩm trí tuệ khách quan (như lý thuyết khoa học, sách vở, tác phẩm nghệ thuật, bài toán) độc lập với tâm trí chủ quan cá nhân",
        "Thế giới tâm linh"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 科学理论的演变乃是独立于肉身主体的客观思想世界（世界三）中的演化博弈."
    },
    {
      "id": "q3",
      "question_vi": "Sự tương đồng giữa tiến hóa sinh học và tiến hóa tri thức khoa học thể hiện qua cơ chế nào?",
      "options_vi": [
        "Cả hai đều diễn ra trong phòng thí nghiệm",
        "Các giả thuyết khoa học mới tương đương với 'đột biến gen ngẫu nhiên', và các thực nghiệm phản biện khoa học đóng vai trò 'chọn lọc tự nhiên' đào thải lý thuyết sai lầm",
        "Không có sự tương đồng nào"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 猜想如同基因突变，而实验检验与批判筛选则构成了淘汰劣质假说的选择压力."
    }
  ]
