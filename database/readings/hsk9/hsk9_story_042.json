  "quiz": [
    {
      "id": "q1",
      "question_vi": "Khác biệt lớn nhất của Đạo đức học đức hạnh (Virtue Ethics) so với Thuyết vị lợi và Đạo đức nghĩa vụ là gì?",
      "options_vi": [
        "Không quan tâm đến con người",
        "Không tập trung vào việc tính toán kết quả hay tuân theo luật lệ cứng nhắc, mà tập trung vào phẩm chất tính cách và sự bồi dưỡng đức hạnh tốt đẹp của con người",
        "Bắt buộc mọi người phải sống khổ hạnh"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 将伦理思考的重心从行动规则转向主体德性的培育塑造."
    },
    {
      "id": "q2",
      "question_vi": "Khái niệm 'Phronesis' (实践智慧 - Sự khôn ngoan thực tiễn) của Aristotle có ý nghĩa gì trong ra quyết định?",
      "options_vi": [
        "Học thuộc lòng sách vở",
        "Khả năng phán đoán nhạy bén và thấu suốt để đưa ra hành động đúng đắn, hài hòa (đạo Trung dung) trong các hoàn cảnh thực tế phức tạp và xung đột",
        "Làm theo lệnh của máy móc"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 实践智慧强调在充满冲突的情境中，依凭深思熟虑做出兼顾原则的中道恰当决断."
    },
    {
      "id": "q3",
      "question_vi": "Mục tiêu tối hậu của đời sống con người theo Aristotle là khái niệm 'Eudaimonia' (美满幸福), mang ý nghĩa gì?",
      "options_vi": [
        "Có thật nhiều tiền bạc của cải",
        "Sự hưng thịnh, trác tuyệt và phát triển viên mãn trọn vẹn của tiềm năng con người trong đời sống đức hạnh thiện hảo",
        "Khoái lạc thể xác nhất thời"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 致力于促进人类行动者实践卓越与获得美满幸福（Eudaimonia）."
    }
  ]
}