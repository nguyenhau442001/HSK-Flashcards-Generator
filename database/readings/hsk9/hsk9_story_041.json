  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hiện tượng 'Tính tới hạn tự tổ chức' (Self-Organized Criticality - SOC) của Per Bak miêu tả điều gì?",
      "options_vi": [
        "Mọi thứ đều hoàn toàn hỗn loạn vô trật tự",
        "Hệ thống tự phát tiến hóa và duy trì trạng thái nằm ngay bên bờ vực tới hạn, nơi một tác động cực nhỏ có thể gây ra hậu quả cực lớn",
        "Mọi sự cố đều có thể dự báo chính xác giờ giấc"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 复杂系统无需外界微调即可自发演化至临界相变边缘的机制."
    },
    {
      "id": "q2",
      "question_vi": "Trong mô hình đống cát, điều gì quyết định một hạt cát rơi xuống sẽ gây ra vụ sụp đổ nhỏ hay một trận lở cát khổng lồ?",
      "options_vi": [
        "Do kích thước của hạt cát đó to hơn",
        "Do trạng thái kết nối tới hạn của toàn bộ đống cát tích lũy trước đó, cùng một tác động nhỏ như nhau có thể kích hoạt vụ lở ở mọi quy mô theo luật lũy thừa",
        "Do có người thổi gió vào đống cát"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 一粒微小沙子既可能引起微小位移，也可能触发波及整个系统的灾难性大崩塌."
    },
    {
      "id": "q3",
      "question_vi": "Quy luật thống kê nào phản ánh mối quan hệ giữa quy mô thảm họa và tần suất xảy ra trong hệ tới hạn?",
      "options_vi": [
        "Quy luật phân phối chuẩn hình chuông",
        "Quy luật lũy thừa (Power Law): các vụ sụp đổ nhỏ xảy ra thường xuyên, các vụ sụp đổ lớn ít xảy ra hơn nhưng tuân theo cùng một hàm số mũ liên tục",
        "Quy luật ngẫu nhiên hoàn toàn"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 崩塌规模与其发生频率严格服从无标度幂律分布，共享完全相同的内在机理."
    }
  ]
}