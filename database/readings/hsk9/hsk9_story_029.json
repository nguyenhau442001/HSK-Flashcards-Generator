  "quiz": [
    {
      "id": "q1",
      "question_vi": "Khái niệm 'Kỷ Nhân sinh thế' (Anthropocene) chỉ ra bước ngoặt chấn động nào của Trái Đất?",
      "options_vi": [
        "Khủng long sống lại",
        "Hoạt động công nghiệp và công nghệ của con người đã trở thành một lực lượng địa vật lý chi phối, làm biến đổi vĩnh viễn địa tầng và khí hậu Trái Đất",
        "Trái Đất lạnh đi"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 人类不再是生物学行动者，而是整体演变为足以与构造板块比肩的地质营力."
    },
    {
      "id": "q2",
      "question_vi": "Dấu mốc địa chất (Golden Spike) đánh dấu sự bắt đầu của kỷ Nhân sinh thế vào giữa thế kỷ 20 là gì?",
      "options_vi": [
        "Vỏ sò hóa thạch",
        "Bụi phóng xạ từ các vụ thử hạt nhân, hạt vi nhựa nhân tạo và tro bay công nghiệp lắng đọng trong các tầng trầm tích đất đá",
        "Gỗ cây cổ thụ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 岩层中富集的放射性核素沉降物与塑料微粒，留下了改变地层的永久铁证."
    },
    {
      "id": "q3",
      "question_vi": "Bước ngoặt triết học quan trọng nhất nảy sinh từ kỷ Nhân sinh thế là gì?",
      "options_vi": [
        "Tôn vinh con người là chúa tể muôn loài",
        "Bác bỏ thuyết nhị nguyên tách biệt con người khỏi tự nhiên, đoạn tuyệt chủ nghĩa vị nhân cực đoan để thiết lập 'Nghị viện muôn loài'",
        "Phá hủy toàn bộ máy móc"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư và năm viết: 宣告了人与自然二元对立神话的破灭，确立万物议会范式，赋予非人存在物主体地位."
    }
  ]
