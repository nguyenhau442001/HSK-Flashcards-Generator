  "quiz": [
    {
      "id": "q1",
      "question_vi": "Tôn chỉ cốt lõi của Nho gia được tóm gọn qua quan niệm nào?",
      "options_vi": [
        "Thuận theo tự nhiên vô vi",
        "Nhân nghĩa lễ trí và lý tưởng tu thân tề gia trị quốc bình thiên hạ",
        "Dùng hình phạt nặng để kiểm soát"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 崇尚仁义礼智，追求修身齐家治国平天下的道德理想境界."
    },
    {
      "id": "q2",
      "question_vi": "Môn phái nào đề cao tư tưởng thương yêu bình đẳng không phân biệt và phản đối chiến tranh xâm lược?",
      "options_vi": [
        "Pháp gia",
        "Mặc gia (Kiêm ái, Phi công)",
        "Danh gia"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 墨家兼爱非攻以济世救民."
    },
    {
      "id": "q3",
      "question_vi": "Ý nghĩa lịch sử lâu dài của thời kỳ Bách gia tranh minh là gì?",
      "options_vi": [
        "Làm suy thoái nền văn hóa",
        "Định hình sắc màu tinh thần và tạo dựng tọa độ tư tưởng vĩnh hằng cho triết học",
        "Khiến chữ viết bị chia rẽ"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 塑造了包容多元的宽广胸怀，为人类哲学沉思贡献了永恒的思想坐标."
    }
  ]
