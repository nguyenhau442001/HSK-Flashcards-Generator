  "quiz": [
    {
      "id": "q1",
      "question_vi": "Heidegger chỉ trích điều gì trong lịch sử hình nhi thượng học phương Tây?",
      "options_vi": [
        "Phát triển công nghệ quá chậm",
        "Sự lãng quên câu hỏi về 'Tồn tại' suốt hai ngàn năm",
        "Bỏ qua các định luật toán học"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 深刻反思西方形而上学历经两千年的存在之遗忘."
    },
    {
      "id": "q2",
      "question_vi": "Bản chất hiện sinh của con người được định nghĩa như thế nào trong triết học hiện sinh?",
      "options_vi": [
        "Thực thể tĩnh tại không đổi",
        "Hữu thể mang tính thời gian, bị ném vào hoàn cảnh và tồn tại hướng về cái chết",
        "Cỗ máy cơ học hoàn hảo"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 是时刻被抛入特定历史境遇中朝向死亡而生的时间性存在."
    },
    {
      "id": "q3",
      "question_vi": "Ý nghĩa thực tiễn sâu xa của việc truy vấn bản thể tồn tại là gì?",
      "options_vi": [
        "Là trò chơi câu chữ vô nghĩa",
        "Đánh thức tâm trí đắm chìm và tìm lại trải nghiệm trú ngụ thi vị giữa nhân gian",
        "Khiến con người thêm tuyệt vọng"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 唤醒人类沉沦心智、重获诗意栖居神圣体验的救赎之途."
    }
  ]
