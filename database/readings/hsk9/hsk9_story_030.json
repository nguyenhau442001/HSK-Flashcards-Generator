  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mối đe dọa lớn nhất của Thuyết quyết định cơ học (Hard Determinism) đối với xã hội loài người là gì?",
      "options_vi": [
        "Làm cho máy móc không chạy được",
        "Nếu mọi hành vi đều do định luật vật lý tiền định từ trước, con người không có ý chí tự do thực sự và toàn bộ hệ thống trách nhiệm đạo đức, luật pháp sẽ sụp đổ",
        "Không ai muốn ăn cơm"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 坚硬决定论断言自由意志是幻觉，根本性动摇了道德赞誉、惩罚与个人责任的合法性."
    },
    {
      "id": "q2",
      "question_vi": "Thí nghiệm tư duy nổi tiếng của Harry Frankfurt (Frankfurt Cases) đã bác bỏ nguyên tắc triết học nào?",
      "options_vi": [
        "Bác bỏ định luật hấp dẫn",
        "Bác bỏ nguyên tắc 'Phải có khả năng làm khác đi' (PAP): Một người vẫn phải chịu trách nhiệm đạo đức đầy đủ ngay cả khi họ không thể làm khác đi, miễn là họ thực sự muốn làm điều đó",
        "Bác bỏ việc xét xử tội phạm"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 证明了具备做出其他行动的可能性并非道德责任的必要先决条件."
    },
    {
      "id": "q3",
      "question_vi": "Quan điểm cốt lõi của 'Thuyết tương dung' (Compatibilism) về tự do là gì?",
      "options_vi": [
        "Ý chí tự do có thể vi phạm định luật vật lý",
        "Tự do hoàn toàn có thể tương dung với thuyết quyết định: tự do là hành động theo đúng ý muốn sâu sắc, có suy nghĩ lý tính và không bị cưỡng bức từ bên ngoài",
        "Con người là robot vô tri"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư và năm viết: 自由在于意愿、反思与其行动之间的自洽，足以支撑实质道义价值的道德责任."
    }
  ]
}