  "quiz": [
    {
      "id": "q1",
      "question_vi": "Khái niệm 'Bẫy Thucydides' (Thucydides Trap) trong quan hệ quốc tế cảnh báo nguy cơ nào?",
      "options_vi": [
        "Nguy cơ khủng hoảng kinh tế",
        "Nguy cơ xung đột chiến tranh tất yếu khi một cường quốc đang trỗi dậy thách thức vị thế thống trị của cường quốc bá quyền đương nhiệm",
        "Nguy cơ thiên tai dịch bệnh"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 修昔底德陷阱的历史阴云叠加，将多边治理体系推向空前的危机边缘."
    },
    {
      "id": "q2",
      "question_vi": "Hiện tượng 'Bẫy Kindleberger' (Kindleberger Trap) phản ánh điều gì?",
      "options_vi": [
        "Không có tiền mua vũ khí",
        "Tình trạng cường quốc cũ không còn đủ khả năng cung ứng hàng hóa công toàn cầu (như an ninh, viện trợ), trong khi cường quốc mới chưa sẵn sàng gánh vác",
        "Thương mại bị đóng băng"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 金德尔伯格陷阱的全球公共品供给赤字交织叠加，引发效能危机."
    },
    {
      "id": "q3",
      "question_vi": "Đặc điểm của trật tự thế giới tương lai đang hình thành là gì?",
      "options_vi": [
        "Một siêu cường thống trị tuyệt đối mãi mãi",
        "Trật tự đa cực linh hoạt với các chiến lược tự chủ chiến lược và cân bằng quyền lực phức hợp thay thế thế giới đơn cực",
        "Tất cả các nước sáp nhập thành một"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ ba và năm viết: 新兴力量崛起，同盟体系正被战略自主替代，建构多极包容性均势机制."
    }
  ]
