  "quiz": [
    {
      "id": "q1",
      "question_vi": "Cấu trúc nghịch lý của 'Vòng tròn chú giải học' (Hermeneutic Circle) được định nghĩa như thế nào?",
      "options_vi": [
        "Không bao giờ hiểu được cuốn sách",
        "Muốn hiểu từng bộ phận phải dựa vào tổng thể, nhưng muốn nắm bắt tổng thể lại bắt buộc phải đi qua từng bộ phận",
        "Đọc sách theo vòng tròn"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 对局部的理解依赖于对整体的把握，而对整体的理解又建立在局部的阐发之上."
    },
    {
      "id": "q2",
      "question_vi": "Khái niệm 'Dung hợp chân trời' (Horizontverschmelzung) của Gadamer hàm ý điều gì?",
      "options_vi": [
        "Người đọc phải quên sạch quá khứ của mình",
        "Chân trời lịch sử của người đọc (tiền hiểu biết) và chân trời lịch sử của văn bản đối thoại gặp gỡ, bổ sung và nâng tầm lẫn nhau",
        "Đốt hết sách cổ đi"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 前理解构成了先决视域，在对话中实现深刻的视域融合与精神升华."
    },
    {
      "id": "q3",
      "question_vi": "Yêu cầu then chốt khi tiến hành diễn giải các văn bản triết học giữa các nền văn minh khác nhau là gì?",
      "options_vi": [
        "Áp đặt tuyệt đối các khái niệm phương Tây lên văn hóa phương Đông",
        "Liên tục phản tư định kiến của bản thân và giữ tinh thần đối thoại bình đẳng, tôn trọng bản sắc dị biệt",
        "Không cần dịch thuật"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ năm và sáu viết: 在开放对话中反思自身前见，不是抹杀差异的同化，而是在激荡中领悟多元诗意."
    }
  ]
