  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hiện trạng phổ biến trong các khu chung cư cao tầng hiện nay là gì?",
      "options_vi": [
        "Mọi người tụ tập hàng ngày",
        "Cửa đóng chặt khiến hàng xóm sát vách thành người xa lạ",
        "Không ai muốn ở nhà"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 紧闭的防盗门往往让对门邻居变得形同陌路."
    },
    {
      "id": "q2",
      "question_vi": "Các khu dân cư đã làm gì để kết nối người dân với nhau?",
      "options_vi": [
        "Xây tường rào cao hơn",
        "Tạo không gian công cộng mở, vườn hoa và tổ chức chợ phiên, hoạt động gia đình",
        "Phạt tiền người không nói chuyện"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 打造开放式的公共交往空间与社区花园，举办跳蚤市场与亲子活动."
    },
    {
      "id": "q3",
      "question_vi": "Giá trị lớn nhất mà một cộng đồng giàu sức sống mang lại là gì?",
      "options_vi": [
        "Làm tăng giá thuê nhà",
        "Nâng cao cảm giác gắn bó thuộc về nơi chốn và xây dựng xã hội hài hòa",
        "Thu hút nhiều người bán hàng rong"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 提升了居民的归属感，更是构筑和谐社会的坚固基石."
    }
  ]
