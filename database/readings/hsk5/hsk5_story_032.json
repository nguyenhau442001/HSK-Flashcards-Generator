  "quiz": [
    {
      "id": "q1",
      "question_vi": "Lợi ích rõ rệt của hình thức làm việc từ xa đối với nhân viên là gì?",
      "options_vi": [
        "Không cần làm việc nữa",
        "Tránh được cảnh tắc đường giờ cao điểm và linh hoạt sắp xếp thời gian",
        "Được trả lương gấp đôi"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 不再需要每天忍受早晚高峰漫长而拥挤的通勤，能够更加自由灵活地规划个人日程."
    },
    {
      "id": "q2",
      "question_vi": "Thách thức tiềm ẩn khi làm việc tại nhà là gì?",
      "options_vi": [
        "Ranh giới công việc và cuộc sống bị mờ nhạt, dễ dẫn đến kiệt sức vì làm việc liên tục",
        "Không có mạng Internet",
        "Không thể trò chuyện với ai"
      ],
      "answer": 0,
      "explanation_vi": "Trong câu có viết: 工作与居家生活的界限逐渐模糊，也容易导致一些人陷入无休止加班的精神疲惫中."
    },
    {
      "id": "q3",
      "question_vi": "Lời khuyên để duy trì sự cân bằng khi làm việc từ xa là gì?",
      "options_vi": [
        "Làm việc ngay trên giường ngủ",
        "Lập thời gian biểu quy củ, có góc làm việc riêng và tắt thiết bị sau giờ làm",
        "Làm việc suốt đêm"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 建立规律的作息时间表，设立独立的工作空间，并在下班后彻底关闭工作通讯."
    }
  ]
