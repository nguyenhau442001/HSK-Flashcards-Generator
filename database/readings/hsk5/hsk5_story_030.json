  "quiz": [
    {
      "id": "q1",
      "question_vi": "Cơ chế của liệu pháp âm nhạc trong y học hiện đại là gì?",
      "options_vi": [
        "Bắt bệnh nhân học thuộc lời bài hát",
        "Dùng giai điệu và tiết tấu đặc thù để điều hòa cảm xúc rối loạn",
        "Bật nhạc lớn hết cỡ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 通过特定旋律与节奏的刺激，帮助患者调节紊乱的情绪."
    },
    {
      "id": "q2",
      "question_vi": "Tác dụng thể chất của các khúc nhạc cổ điển êm dịu là gì?",
      "options_vi": [
        "Làm cơ bắp căng thẳng hơn",
        "Giảm sự hưng phấn của thần kinh giao cảm và giúp cơ bắp thư giãn",
        "Gây chóng mặt"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 降低交感神经的兴奋度，使紧绷的肌肉得到彻底放松."
    },
    {
      "id": "q3",
      "question_vi": "Âm nhạc đẹp được ví như hình ảnh gì cho tâm hồn con người?",
      "options_vi": [
        "Cơn mưa bão lớn",
        "Dòng suối ngọt lành mang lại sự bình an dài lâu",
        "Bức tường thành ngăn cách"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 如同给疲惫的心灵注入一缕甘甜的清泉，带来持久的安宁."
    }
  ]
