  "quiz": [
    {
      "id": "q1",
      "question_vi": "Đặc điểm đáng kinh ngạc nhất của kỹ thuật ghép mộng mộng (榫卯) là gì?",
      "options_vi": [
        "Dùng rất nhiều đinh sắt dày",
        "Không dùng đinh, chỉ dựa vào các khớp gỗ lồi lõm ăn khớp chặt chẽ",
        "Dùng keo dán hiện đại"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 古代工匠不用一颗铁钉，仅凭凹凸相契的木构件相互咬合."
    },
    {
      "id": "q2",
      "question_vi": "Ưu điểm nổi bật của kết cấu mộng gỗ khi xảy ra động đất là gì?",
      "options_vi": [
        "Cứng đơ và dễ gãy",
        "Có tính liên kết dẻo dai giúp hấp thụ năng lượng rung chấn mà không sụp đổ",
        "Rơi ra từng mảnh nhỏ"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 优异的抗震性能，在发生剧烈地震时能够通过轻微形变吸收能量而不坍塌."
    },
    {
      "id": "q3",
      "question_vi": "Trí tuệ mộng gỗ phản ánh triết lý gì của phương Đông?",
      "options_vi": [
        "Con người chinh phục và phá hủy thiên nhiên",
        "Con người hòa hợp cộng sinh cùng vật liệu tự nhiên và tinh thần nghệ nhân tinh xảo",
        "Tiết kiệm chi phí tối đa"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 不仅体现了工匠精神，更展示了人与自然材料和谐共存的东方哲学."
    }
