  "quiz": [
    {
      "id": "q1",
      "question_vi": "Vai trò cốt lõi của người lãnh đạo ưu tú là gì?",
      "options_vi": [
        "Chỉ kiểm soát giờ giấc nhân viên",
        "Phác thảo tầm nhìn và truyền cảm hứng khích lệ tinh thần",
        "Làm hết mọi việc một mình"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 更是愿景的描绘者与士气的激励者."
    },
    {
      "id": "q2",
      "question_vi": "Hành động thể hiện nghệ thuật 'dùng người tài tình' (知人善任) là gì?",
      "options_vi": [
