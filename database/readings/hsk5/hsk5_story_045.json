  "quiz": [
    {
      "id": "q1",
      "question_vi": "Căn nguyên thực sự của chứng trì hoãn theo nghiên cứu tâm lý học là gì?",
      "options_vi": [
        "Do tính lười biếng bẩm sinh",
        "Do nỗi sợ thất bại và áp lực của chủ nghĩa hoàn hảo quá đà",
        "Do cơ thể thiếu ngủ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 根源往往不是单纯的懒惰，而是对失败的恐惧以及追求完美的心理压力."
    },
    {
      "id": "q2",
