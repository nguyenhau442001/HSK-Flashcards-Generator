  "quiz": [
    {
      "id": "q1",
      "question_vi": "Động lực lớn nhất giúp các thầy cô giáo trẻ vượt qua khó khăn thiếu thốn ở bản làng là gì?",
      "options_vi": [
        "Tiền lương cao",
        "Ánh mắt trong trẻo khao khát tri thức của học trò vùng cao",
        "Khí hậu mát mẻ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 孩子们渴望求知的清澈双眼让一切付出都变得值得."
    },
    {
      "id": "q2",
