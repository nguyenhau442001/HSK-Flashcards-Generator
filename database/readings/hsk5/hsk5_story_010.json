  "quiz": [
    {
      "id": "q1",
      "question_vi": "Phong trào 'Ăn chậm' (Slow food) khuyến khích điều gì?",
      "options_vi": [
        "Ăn đồ đóng hộp",
        "Bước chậm lại, tự chọn nguyên liệu tươi và nấu ăn bằng cả tấm lòng",
        "Nhịn ăn"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 放慢匆忙的脚步，亲自挑选新鲜食材并用心烹饪."
    },
    {
      "id": "q2",
      "question_vi": "Khoảnh khắc hạnh phúc mộc mạc nhất được miêu tả là gì?",
      "options_vi": [
        "Mua sắm đồ hiệu đắt tiền",
        "Quây quần cùng người thân thưởng thức bữa cơm nóng ấm",
        "Đi du lịch một mình"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 与家人朋友围坐在一起，细细品味热腾腾的饭菜，是最朴素的幸福时光."
    },
    {
      "id": "q3",
      "question_vi": "Hơi ấm bếp lửa gia đình mang lại giá trị tinh thần nào?",
      "options_vi": [
        "Gây tốn điện nước",
        "Xoa dịu sự mệt mỏi sau ngày dài lao động vất vả",
        "Làm căn nhà bừa bộn"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 温暖烟火气，最能治愈一天奔波劳累所带来的疲惫."
    }
  ]
