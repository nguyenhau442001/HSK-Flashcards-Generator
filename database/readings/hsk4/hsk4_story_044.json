  "quiz": [
    {
      "id": "q1",
      "question_vi": "Triết lý võ học nòng cốt của Thái Cực Quyền là gì?",
      "options_vi": [
        "Dùng sức đập vỡ tảng đá",
        "'Lấy nhu thắng cương, lấy tĩnh chế động' (以柔克刚，以静制动)",
        "Tốc độ nhanh nhất có thể"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 强调‘以柔克刚，以静制动’，动作缓慢舒展，圆活连贯."
    },
    {
      "id": "q2",
      "question_vi": "Yêu cầu về hơi thở và tâm thế khi luyện tập Thái Cực là gì?",
      "options_vi": [
        "Thở gấp gáp qua miệng",
        "'Tâm tĩnh thân lỏng, khí trầm đan điền' và thở bụng sâu đều",
        "Căng cứng các cơ bắp"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 做到‘心静体松，气沉丹田’... 深长均匀的腹式呼吸."
    },
    {
      "id": "q3",
      "question_vi": "Vì sao ngày nay nhiều thanh niên cũng hứng thú tập luyện Thái Cực Quyền?",
      "options_vi": [
        "Để biểu diễn trên phố",
        "Để giảm đau mỏi cổ vai gáy và xua tan căng thẳng tâm lý",
        "Bắt buộc theo môn học đại học"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 许多现代青年也开始通过练习太极来缓解颈肩酸痛和精神压力."
    }
  ]
