  "quiz": [
    {
      "id": "q1",
      "question_vi": "Nguy cơ lớn nhất khi phát triển du lịch tại các làng cổ là gì?",
      "options_vi": [
        "Không có ai đến tham quan",
        "Quá đà thương mại hóa và phá vỡ diện mạo lịch sử nguyên bản",
        "Chi phí vé vào cổng quá rẻ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 带来了过度商业化的隐患... 破坏古村落的原真历史风貌."
    },
    {
      "id": "q2",
      "question_vi": "Nguyên tắc cốt lõi trong quy hoạch trùng tu kiến trúc cổ là gì?",
      "options_vi": [
        "Đập đi xây mới toàn bộ bằng bê tông",
        "'Trùng tu như thuở ban đầu' (修旧如旧), duy trì kết cấu gỗ đá mộc mạc",
        "Sơn màu sặc sỡ hiện đại"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 坚持‘修旧如旧’的原则，重点维护民居的古朴木石结构."
    },
    {
      "id": "q3",
      "question_vi": "Làm thế nào để văn hóa làng cổ được kế thừa bền vững?",
      "options_vi": [
        "Đưa hết người dân ra khỏi làng",
        "Khai thác nghề thủ công truyền thống và cân bằng giữa bảo tồn với phát triển",
        "Biến làng thành trung tâm mua sắm"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 深入挖掘当地世代流传的民俗手工艺... 找到精妙的平衡."
    }
