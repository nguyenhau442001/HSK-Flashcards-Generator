  "quiz": [
    {
      "id": "q1",
      "question_vi": "Triết lý nghệ thuật cốt lõi của hoa viên cổ điển Trung Hoa là gì?",
      "options_vi": [
        "Càng nhiều bê tông càng hiện đại",
        "'Dù do người làm ra, ngỡ tự trời sinh' (虽由人作，宛自天开)",
        "Đối xứng tuyệt đối kiểu phương Tây"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 以其‘虽由人作，宛自天开’的崇高艺术境界闻名于世."
    },
    {
      "id": "q2",
      "question_vi": "Kỹ thuật 'bước dời cảnh đổi' (步移景异) mang lại trải nghiệm thị giác nào?",
      "options_vi": [
        "Mỗi bước chân đi trên đường mòn lại mở ra một khung cảnh thơ mộng mới",
        "Chỉ thấy một bức tường trắng đơn điệu",
        "Gây chóng mặt cho người xem"
      ],
      "answer": 0,
      "explanation_vi": "Trong bài có câu: 创造出步移景异的奇妙空间效果... 每走一步都能欣赏到一幅全新的诗意画卷."
    },
    {
      "id": "q3",
      "question_vi": "Ý nghĩa tinh thần sâu sắc nhất của hoa viên cổ truyền là gì?",
      "options_vi": [
        "Nơi cất giữ kho báu ngầm",
        "Biểu trưng cho khát vọng hòa hợp cộng sinh giữa con người và tự nhiên",
        "Chỉ dùng để nuôi cá cảnh"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 追求人与自然和谐共生的精神家园."
    }
