  "quiz": [
    {
      "id": "q1",
      "question_vi": "Điều cốt lõi quyết định cảm giác hạnh phúc của một con người là gì?",
      "options_vi": [
        "Số lượng tài sản kếch xù sở hữu",
        "Thái độ nội tâm khi nhìn nhận và đón nhận sự việc",
        "Không bao giờ gặp bất kỳ thử thách nào"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 并不是外界客观发生的事实，而是我们看待事物的内心态度."
    },
    {
      "id": "q2",
      "question_vi": "Hành động đơn giản mỗi ngày giúp tích lũy cảm giác hạnh phúc bền bỉ là gì?",
