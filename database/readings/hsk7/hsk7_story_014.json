  "quiz": [
    {
      "id": "q1",
      "question_vi": "Công nghệ nào giúp ruộng đồng thông minh tối ưu hóa năng suất mùa màng?",
      "options_vi": [
        "Cày bừa thủ công thô sơ",
        "Cảm biến nhiệt ẩm đất đai và máy bay không người lái bảo vệ thực vật",
        "Bón phân hóa học quá mức"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 智慧农田通过土壤温湿度传感器与无人机精准植保，实现了水肥药一体化调控."
    },
    {
      "id": "q2",
      "question_vi": "Công cụ nào giúp minh bạch quy trình vận chuyển và chất lượng nông sản cho người tiêu dùng?",
      "options_vi": [
        "Quảng cáo truyền hình không giấy tờ",
        "Mạng lưới chuỗi lạnh và tem truy xuất nguồn gốc bằng công nghệ chuỗi khối",
        "Truyền miệng qua người quen"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có viết: 依托冷链物流保鲜网络与区块链溯源标签，消费者能够全程透明查看."
    },
    {
      "id": "q3",
      "question_vi": "Ý nghĩa lớn của thương mại điện tử livestream đối với bà con nông dân là gì?",
      "options_vi": [
        "Làm giá thành tăng vọt khó bán",
        "Mở rộng kênh tiêu thụ, đưa nông sản từ vùng sâu vùng xa đến thẳng bàn ăn đô thị",
        "Khiến nông sản bị ứ đọng"
      ],
      "answer": 1,
