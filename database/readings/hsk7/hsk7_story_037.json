  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hành vi 'chọn một trong hai' (二选一) trên nền tảng thương mại điện tử bị xử lý vì lý do gì?",
      "options_vi": [
        "Vì khuyến khích cạnh tranh công bằng",
        "Vì lạm dụng vị thế thống lĩnh thị trường để tước đoạt quyền tự do kinh doanh của thương nhân",
        "Vì giảm giá quá sâu cho khách hàng"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 重罚滥用市场支配地位限制商户自主经营与阻挠跨平台互联互通的违法行径."
    },
    {
      "id": "q2",
      "question_vi": "Hiện tượng 'dùng thuật toán phân biệt giá' (大数据杀熟) xâm phạm quyền lợi nào của người tiêu dùng?",
      "options_vi": [
        "Quyền tự do ngôn luận",
        "Quyền được biết thông tin trung thực và quyền giao dịch công bằng bình đẳng",
        "Quyền khiếu nại quốc tế"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 坚决取缔差异化算法定价，切实保障消费者的知情权与公平交易权."
    },
    {
      "id": "q3",
      "question_vi": "Mục đích cốt lõi của công tác chống độc quyền nền tảng số là gì?",
      "options_vi": [
        "Tiêu diệt các công ty công nghệ trong nước",
        "Thiết lập môi trường cạnh tranh lành mạnh, mở rộng cánh cửa sáng tạo và phục vụ kinh tế thực thể",
        "Đóng cửa mạng Internet"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối nhấn mạnh: 不是限制行业发展，而是为了引导数字经济行稳致远、回归服务实体初衷."
    }
