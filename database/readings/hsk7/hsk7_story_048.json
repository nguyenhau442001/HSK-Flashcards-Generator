  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mục tiêu cốt lõi của sáng kiến Khoa học Mở (Open Science) là gì?",
      "options_vi": [
        "Khóa kín toàn bộ tài liệu nghiên cứu lại",
        "Phá vỡ bức tường thu phí độc quyền học thuật, chia sẻ miễn phí dữ liệu nghiên cứu để thúc đẩy hợp tác khoa học",
        "Cấm các học giả nước ngoài giao lưu"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 打破学术资源垄断的壁垒，推动科研成果与原始实验数据免费开源开放."
    },
    {
      "id": "q2",
