  "quiz": [
    {
      "id": "q1",
      "question_vi": "Lợi ích của mô hình kho hàng hải ngoại (Overseas Warehouse) là gì?",
      "options_vi": [
        "Làm kéo dài thời gian giao hàng",
        "Rút ngắn thời gian vận chuyển và giảm thiểu chi phí hoàn trả hàng hóa",
        "Tăng chi phí lưu kho không kiểm soát"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 海外仓的前置备货布局与数字化智能分拣，大幅缩短了跨国货物的派送周期并显著降低了退换货成本."
    },
    {
      "id": "q2",
      "question_vi": "Nền tảng 'Một cửa' (Single Window) mang lại tiện ích gì cho doanh nghiệp ngoại thương?",
      "options_vi": [
        "Buộc doanh nghiệp phải đến từng cơ quan nộp hồ sơ giấy",
        "Hoàn tất trực tuyến một cửa các thủ tục khai báo hải quan, nộp thuế và quyết toán ngoại tệ",
        "Ngừng hỗ trợ xuất khẩu"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 单一窗口综合服务平台的推广，使企业能够在线一站式完成通关申报、关税征缴与外汇核销."
    },
    {
      "id": "q3",
      "question_vi": "Lợi thế của doanh nghiệp nhỏ khi tham gia nền tảng xuyên biên giới là gì?",
      "options_vi": [
        "Phải qua rất nhiều đại lý trung gian",
        "Bỏ qua các khâu trung gian, tiếp cận trực tiếp người tiêu dùng toàn cầu và xây dựng thương hiệu",
        "Chỉ được bán hàng thanh lý"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư có viết: 绕开多层中间商，直接连接全球终端买家并逐步塑造自主国际品牌."
    }
