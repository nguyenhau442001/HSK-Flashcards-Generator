  "quiz": [
    {
      "id": "q1",
      "question_vi": "Vai trò của việc kết hợp chính sách tài khóa và tiền tệ là gì?",
      "options_vi": [
        "Chỉ tập trung vào đầu cơ bất động sản",
        "Hỗ trợ chuẩn xác kinh tế thực thể và nghiên cứu công nghệ",
        "In thêm thật nhiều tiền"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 精准支持实体经济和科技创新企业的研发投入."
    },
    {
      "id": "q2",
      "question_vi": "Mục tiêu chính của cải cách cơ cấu phía cung là gì?",
      "options_vi": [
        "Giữ nguyên các nhà máy ô nhiễm",
        "Loại bỏ năng lực lạc hậu, bồi dưỡng ngành mới nổi chiến lược",
        "Giảm tiền lương người lao động"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 淘汰落后产能并培育具有核心竞争力的战略性新兴产业."
    },
    {
      "id": "q3",
      "question_vi": "Yếu tố then chốt giúp nền kinh tế giữ vững sự dẻo dai trước thử thách là gì?",
      "options_vi": [
        "Chỉ chú trọng tăng trưởng nóng",
        "Quy hoạch thống nhất giữa phát triển và an ninh",
        "Đóng cửa biên giới"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 统筹发展与安全两件大事，才能确保经济保持充足的韧性与后劲."
    }
  ]
