  "quiz": [
    {
      "id": "q1",
      "question_vi": "Ưu thế nổi trội nhất của công nghệ truyền tải điện siêu cao áp (UHV) là gì?",
      "options_vi": [
        "Chi phí hao hụt điện năng cực cao",
        "Truyền tải dung lượng siêu lớn trên khoảng cách hàng ngàn km với độ tiêu hao cực thấp",
        "Chỉ truyền được trong phạm vi một khu phố"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 具备大容量、远距离、低损耗与少占地的显著优势."
    },
    {
      "id": "q2",
      "question_vi": "Giải pháp nào giúp làm giảm bớt dao động thất thường khi tích hợp năng lượng tái tạo vào lưới điện?",
      "options_vi": [
        "Cắt điện toàn bộ người dân",
        "Sự phối hợp điều hòa phụ tải giữa thủy điện tích năng và trạm lưu trữ điện năng quy mô lớn",
        "Đốt thêm củi khô"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 抽水蓄能电站与大型电化学储能电站的协同调峰，有效熨平了新能源冲击."
    },
    {
      "id": "q3",
      "question_vi": "Mục tiêu chiến lược của hành lang siêu cao áp là gì?",
      "options_vi": [
        "Chuyển điện sạch từ vùng sa mạc xa xôi về thẳng các trung tâm công nghiệp ven biển",
        "Ngừng cấp điện cho miền núi",
        "Chỉ xuất khẩu điện thô"
