  "quiz": [
    {
      "id": "q1",
      "question_vi": "Cơ sở dữ liệu nào giúp ngân hàng cấp vốn tín chấp trực tuyến cho doanh nghiệp nhỏ mà không cần thế chấp đất đai?",
      "options_vi": [
        "Dự đoán bói toán",
        "Dữ liệu hóa đơn nộp thuế, dòng tiền hóa đơn bán hàng và thông tin thanh toán tiền điện nước minh bạch",
        "Chỉ cần quen biết lãnh đạo"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 依托税务数据、水电缴纳记录与发票流转信息的大数据画像，精准增信授信."
    },
    {
      "id": "q2",
      "question_vi": "Cơ chế bảo lãnh tín dụng của chính phủ mang lại lợi ích gì cho các hộ kinh doanh?",
      "options_vi": [
        "Tăng thêm thủ tục đòi hối lộ",
        "Chia sẻ rủi ro và bù lãi suất để hạ giảm chi phí vay vốn thực tế",
        "Bắt doanh nghiệp nộp phạt vô cớ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 通过风险共担与财政贴息机制，切实降低了实体小微的综合借贷成本."
    },
    {
      "id": "q3",
      "question_vi": "Ý nghĩa then chốt của tài chính toàn diện (inclusive finance) là gì?",
      "options_vi": [
        "Chỉ cho các tập đoàn tài phiệt vay tiền",
        "Đưa nguồn vốn tiếp cận chính xác tới doanh nghiệp nhỏ và người lao động để kích hoạt sức sống thị trường",
        "Cắt đứt tín dụng nông thôn"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối khẳng định: 让金融活水精准滴灌实体经济最基底层，激活市场主体生机."
    }
  ]
