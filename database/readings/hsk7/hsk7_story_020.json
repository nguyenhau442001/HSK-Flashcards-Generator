  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mục đích của việc áp dụng cơ chế 'Hộp cát thử nghiệm' (Regulatory Sandbox) là gì?",
      "options_vi": [
        "Thả nổi hoàn toàn các rủi ro lừa đảo",
        "Thử nghiệm sản phẩm tài chính sáng tạo trong môi trường an toàn nhằm cân bằng đổi mới và kiểm soát rủi ro",
        "Cấm tiệt mọi sáng tạo thanh toán mới"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 运用监管沙盒机制，在可控的真实环境中测试，平衡创新激励与风险防控."
    },
    {
      "id": "q2",
      "question_vi": "Nguyên tắc cốt lõi trong quản lý các hoạt động tài chính công nghệ là gì?",
      "options_vi": [
        "Không cần giấy phép kinh doanh",
        "Đưa toàn bộ hoạt động tài chính vào quản lý pháp luật nghiêm ngặt và yêu cầu đủ vốn",
        "Để doanh nghiệp tự quyết định luật lệ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 将一切金融活动全面依法纳入严格监管，确保持牌经营与资本充足率要求得到刚性执行."
    },
    {
      "id": "q3",
      "question_vi": "Lằn ranh đỏ tối thượng của hệ thống tài chính quốc gia là gì?",
      "options_vi": [
        "Chấp nhận khủng hoảng xảy ra thường xuyên",
        "Giữ vững an toàn, tuyệt đối không để bùng phát rủi ro tài chính mang tính hệ thống",
        "Cho phép các công ty lớn thao túng thị trường"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối nhấn mạnh: 筑牢金融安全防线，守住不发生系统性金融风险的底线."
    }
  ]
