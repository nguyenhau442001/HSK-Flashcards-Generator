  "quiz": [
    {
      "id": "q1",
      "question_vi": "Giải pháp kỹ thuật nào giúp công trình siêu tiết kiệm năng lượng hạn chế tổn thất nhiệt?",
      "options_vi": [
        "Để cửa sổ luôn mở toang",
        "Tường cách nhiệt hiệu suất cao, kính ba lớp kín khí và hệ thống thu hồi nhiệt gió tươi",
        "Sơn tường màu thật tối"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 超低能耗建筑通过外墙保温系统、三玻两腔门窗及热回收装置，降低暖通负荷."
    },
    {
      "id": "q2",
      "question_vi": "Công nghệ BIPV (quang điện tích hợp công trình) đem lại công năng đặc biệt nào?",
