  "quiz": [
    {
      "id": "q1",
      "question_vi": "Lợi ích của việc thiết kế trung chuyển lập thể 'không khoảng cách' là gì?",
      "options_vi": [
        "Bắt hành khách đi bộ hàng cây số giữa các ga",
        "Giúp hành khách chuyển đổi phương tiện liền mạch, nhanh chóng và tiết kiệm thời gian",
        "Làm tăng số lượng vé phải mua"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 高铁站、国际空港、地铁线路的立体无缝衔接，实现了旅客零距离换乘与高效出行."
    },
    {
      "id": "q2",
      "question_vi": "Phương thức vận tải liên vận đường sắt - đường biển có tác dụng kinh tế gì?",
      "options_vi": [
        "Làm tắc nghẽn các bến cảng",
        "Hạ giảm đáng kể chi phí logistics tổng hợp trên toàn xã hội",
        "Kéo dài hành trình vận chuyển hàng hóa"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 推动公铁联运与海铁联运深度协作，大幅压降了全社会综合物流成本."
    },
    {
      "id": "q3",
      "question_vi": "Xu hướng thiết kế sinh thái ở các đầu mối giao thông hiện đại là gì?",
      "options_vi": [
        "Dùng thật nhiều đèn sợi đốt tốn điện",
        "Sử dụng vật liệu xanh và lắp đặt điện mặt trời áp mái để tiết kiệm năng lượng",
        "Xây dựng bãi rác khổng lồ cạnh sân bay"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 绿色环保建筑材料与光伏屋顶的大面积采用，成为节能减碳示范地标."
    }
  ]
