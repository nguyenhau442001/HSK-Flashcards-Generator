  "quiz": [
    {
      "id": "q1",
      "question_vi": "Ba bộ phận cơ khí cốt lõi nhất quyết định chất lượng và độ chính xác của robot công nghiệp là gì?",
      "options_vi": [
        "Vỏ nhựa, ốc vít và bánh xe",
        "Bộ giảm tốc chính xác cao, động cơ servo và bộ điều khiển chuyển động",
        "Bóng đèn led, dây thừng và nam châm"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 攻克高精度减速器、伺服电机与运动控制器三大核心零部件的技术短板."
    },
    {
      "id": "q2",
      "question_vi": "Đặc tính ưu việt của Robot cộng tác (Cobot - Collaborative Robot) là gì?",
      "options_vi": [
        "Rất dễ gây nguy hiểm cho người xung quanh",
        "Có cảm biến va chạm nhạy bén giúp con người làm việc sát cạnh máy móc trên cùng một bàn an toàn",
        "Chỉ biết đứng yên một chỗ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 配备柔性碰撞防护外壳，使工人能够与智能机械臂在同一个工作台上并肩安全作业."
    },
    {
      "id": "q3",
      "question_vi": "Lực đẩy phát triển kinh tế mới thay thế cho lợi tức nhân công giá rẻ trước đây là gì?",
      "options_vi": [
        "Nhập khẩu hàng thứ phẩm",
        "Lợi tức kỹ sư trình độ cao và lợi tức ứng dụng máy móc tự động hóa (工程师红利与机器红利)",
        "Giảm bớt đầu tư công nghệ"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối nhấn mạnh: 由传统人口红利向工程师红利与机器红利演进，迈向价值链制高点."
    }
