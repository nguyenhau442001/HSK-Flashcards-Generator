  "quiz": [
    {
      "id": "q1",
      "question_vi": "Phương tiện cơ giới hiện đại nào hỗ trợ đắc lực công tác cứu hộ tại vùng bị cô lập do động đất?",
      "options_vi": [
        "Xe đạp thô sơ",
        "Trực thăng cứu nạn hạng nặng đổ bộ đường không, drone trinh sát 3D và xe bắc cầu lắp ghép nhanh",
        "Xe ngựa kéo"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 重型救援直升机空中投送、无人机三维建模与模块化架桥车发挥了中流砥柱作用."
    },
    {
      "id": "q2",
      "question_vi": "Đặc trưng của bộ máy quản lý khẩn cấp hiện đại là gì?",
      "options_vi": [
        "Chỉ huy phân tán mỗi nơi làm một kiểu",
        "Chỉ huy thống nhất, chuyên môn vững vàng, phản ứng nhạy bén và liên thông nhịp nhàng trên dưới",
        "Chờ xin ý kiến sau nhiều ngày mới xử lý"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 构建统一指挥、专常兼备、反应灵敏、上下联动的现代应急管理体制."
    },
    {
      "id": "q3",
      "question_vi": "Tôn chỉ cao nhất của lực lượng cứu nạn cứu hộ thiên tai là gì?",
      "options_vi": [
        "Bảo vệ lợi nhuận doanh nghiệp trước tiên",
        "Nhân dân là trên hết, sinh mệnh con người là trên hết (人民至上、生命至上)",
        "Thu phí cứu nạn thật cao"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối nhấn mạnh: 人民至上、生命至上的坚定信念，托举起守护万家安宁的无上荣光."
    }
  ]
