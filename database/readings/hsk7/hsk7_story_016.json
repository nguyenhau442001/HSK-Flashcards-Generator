  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mô hình hệ thống lương hưu đa tầng bao gồm những trụ cột nào?",
      "options_vi": [
        "Chỉ dựa vào con cái chu cấp",
        "Bảo hiểm cơ bản, niên kim doanh nghiệp và bảo hiểm hưu trí thương mại cá nhân",
        "Chỉ dựa vào tiết kiệm vàng"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 健全以基本养老保险为基础、企业年金为补充、个人商业养老保险为支撑的多层次养老金支柱架构."
    },
    {
      "id": "q2",
      "question_vi": "Mục tiêu của cải tạo không gian không rào cản và thiết bị giám sát thông minh là gì?",
      "options_vi": [
        "Tăng chi phí sinh hoạt cho người già",
        "Nâng cao khả năng tự chủ sinh hoạt và bảo vệ phẩm giá người cao tuổi",
        "Hạn chế người già ra khỏi nhà"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 有效提升了失能及高龄老人的日常生活自主度与尊严."
    },
    {
      "id": "q3",
      "question_vi": "Hệ thống dưỡng lão hiện đại kết hợp những thành tố nào?",
      "options_vi": [
        "Bỏ rơi người già ở vùng xa",
        "Kết hợp dưỡng lão tại gia, chăm sóc cộng đồng và cơ sở chuyên nghiệp y dưỡng",
        "Đưa tất cả vào bệnh viện tâm thần"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ ba viết: 大力发展以居家为依托、社区为纽带、专业机构为支撑的医养结合服务体系."
    }
  ]
