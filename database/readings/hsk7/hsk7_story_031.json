  "quiz": [
    {
      "id": "q1",
      "question_vi": "Tác hại nghiêm trọng của việc khai thác nước ngầm quá mức trong thời gian dài là gì?",
      "options_vi": [
        "Làm cho nước sông dâng cao quá mức",
        "Hình thành phễu hạ thấp mực nước ngầm và gây sụt lún mặt đất",
        "Làm khí hậu lạnh đi"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 长期超采地下水曾导致局部形成漏斗区，引发地面沉降与含水层退化."
    },
    {
      "id": "q2",
      "question_vi": "Biện pháp của mô hình 'Thành phố bọt biển' (Sponge City) giúp ích gì cho nước ngầm?",
      "options_vi": [
        "Đổ bê tông kín toàn bộ mặt đất",
        "Dùng thảm cỏ lõm và vỉa hè thấm nước để tăng khả năng ngấm bổ cập của nước mưa",
        "Thải toàn bộ nước mưa ra biển mà không lọc"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 利用下凹式绿地与透水铺装大幅增强雨水下渗补给地下水的能力."
    },
    {
      "id": "q3",
      "question_vi": "Hành động bị pháp luật nghiêm trị trong bảo vệ tài nguyên nước ngầm là gì?",
      "options_vi": [
        "Trồng cây xanh trên đồi",
        "Lén lút xả trộm nước thải công nghiệp độc hại làm ô nhiễm tầng nước ngầm",
        "Tiết kiệm nước sinh hoạt"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 严厉查处非法偷排工业废水污染潜水的恶劣行径."
    }
  ]
