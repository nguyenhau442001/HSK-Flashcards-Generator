  "quiz": [
    {
      "id": "q1",
      "question_vi": "Thí nghiệm sinh học đáng chú ý nào đã được thực hiện thành công trên trạm vũ trụ?",
      "options_vi": [
        "Nuôi khủng long trong khoang",
        "Khám phá trọn vẹn vòng đời sinh trưởng và nhân giống cây lúa trong môi trường vi trọng lực",
        "Trồng cây cao su lấy mủ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 探索了水稻在微重力环境下的全生命周期繁育规律与基因变异机制."
    },
    {
      "id": "q2",
      "question_vi": "Mục tiêu của tủ thí nghiệm vật lý nguyên tử lạnh trên quỹ đạo là gì?",
      "options_vi": [
        "Đun nóng nước sôi thật nhanh",
        "Dùng laser làm lạnh tạo ra cụm nguyên tử tiệm cận độ không tuyệt đối để khảo sát vật lý lượng tử",
        "Đốt cháy các mảnh rác vũ trụ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có viết: 利用超低温激光冷却技术，有望在太空创造出接近绝对零度的最冷原子团."
    },
    {
      "id": "q3",
      "question_vi": "Thiết bị nào hỗ trợ đắc lực phi hành gia trong các chuyến đi bộ ngoài không gian?",
