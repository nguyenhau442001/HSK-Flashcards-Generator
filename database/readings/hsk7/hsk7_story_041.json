  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hình tượng nào được dùng để nói về tầm quan trọng không thể thiếu của đất hiếm trong công nghiệp?",
      "options_vi": [
        "Gạch xây nhà thô sơ",
        "Vitamin của ngành công nghiệp (工业维生素)",
        "Mùn cưa phế liệu"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 稀土元素作为不可再生的关键工业维生素，是发展的命脉所在."
    },
    {
      "id": "q2",
      "question_vi": "Chuyển dịch chiến lược của ngành đất hiếm từ trước tới nay là gì?",
      "options_vi": [
        "Tiếp tục khai thác bừa bãi và bán đổ bán tháo",
        "Chấm dứt bán quặng thô giá rẻ, kiểm soát tổng lượng khai thác và nâng cao chế tạo nam châm vĩnh cửu công nghệ cao",
        "Tặng miễn phí cho đối thủ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 坚决扭转低价抛售初级原矿局面，推动全产业链向价值链最高端攀升."
    },
