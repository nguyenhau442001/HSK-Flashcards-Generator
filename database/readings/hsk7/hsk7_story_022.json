  "quiz": [
    {
      "id": "q1",
      "question_vi": "Đặc tính kỹ thuật nào của 5G đóng vai trò quyết định trong điều khiển công nghiệp chính xác?",
      "options_vi": [
        "Tốc độ gửi thư điện tử chậm",
        "Băng thông siêu lớn, độ trễ cực thấp và khả năng kết nối rộng khắp",
        "Sóng bắt chập chờn"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 大带宽、低时延与广连接的核心优势，使得工业机器人的毫秒级协同作业成为现实."
    },
    {
      "id": "q2",
      "question_vi": "Ưu điểm nổi bật của việc bảo trì thiết bị dựa trên dữ liệu cảm biến và điện toán đám mây là gì?",
      "options_vi": [
        "Chờ khi máy móc hỏng hẳn mới sửa",
        "Dự báo sớm hao mòn mỏi của linh kiện trước nhiều tuần để chủ động bảo dưỡng",
        "Tốn kém chi phí thay mới liên tục"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có viết: 能够提前数周预测核心零部件的疲劳磨损."
    },
