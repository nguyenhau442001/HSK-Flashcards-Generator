  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mục đích của việc giám sát xuyên thấu (穿透式监测) đối với các luồng vốn xuyên biên giới là gì?",
      "options_vi": [
        "Khuyến khích đầu cơ rửa tiền",
        "Phát hiện sớm và ngăn chặn các luồng vốn nóng (hot money) đầu cơ ngắn hạn bất thường gây chao đảo thị trường",
        "Cấm du khách mang tiền mặt"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 对异常大额短期投机性热钱流动实施穿透式动态监测."
    },
    {
      "id": "q2",
      "question_vi": "Biện pháp nào giúp giảm thiểu rủi ro bị phong tỏa tài sản dự trữ trước các biến động địa chính trị quốc tế?",
      "options_vi": [
        "Giữ toàn bộ tiền mặt ở nước ngoài",
        "Đa dạng hóa cơ cấu tài sản dự trữ ngoại hối và thận trọng tăng tỷ trọng dự trữ vàng",
        "Chỉ mua một loại trái phiếu nước ngoài"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có viết: 多元化配置外汇储备资产结构并稳妥推进黄金储备增持."
    },
    {
      "id": "q3",
