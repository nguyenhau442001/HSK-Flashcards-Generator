  "quiz": [
    {
      "id": "q1",
      "question_vi": "Công nghệ nào được ứng dụng để ghi nhận chính xác từng động tác tinh vi của nghệ nhân?",
      "options_vi": [
        "Chép miệng nhớ nhung",
        "Quét laser 3D, găng tay bắt chuyển động (motion capture) và chụp ảnh siêu nét",
        "Vẽ tranh biếm họa"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 三维激光扫描、动作捕捉手套与微距摄影技术，记录下针法与拉坯微观手法."
    },
    {
      "id": "q2",
      "question_vi": "Khó khăn thực tế lớn nhất mà các nghề thủ công cổ truyền gặp phải hiện nay là gì?",
      "options_vi": [
        "Vật liệu quá rẻ không ai muốn mua",
        "Nghệ nhân kế thừa tuổi tác đã cao và tình trạng thiếu hụt thế hệ trẻ tiếp nối",
        "Có quá nhiều người muốn học nghề"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài nêu: 许多手艺面临传承人年事已高、后继乏人的现实困境."
    },
    {
      "id": "q3",
      "question_vi": "Cách thức hiệu quả để người trẻ thêm yêu thích các hoa văn và kỹ nghệ cổ truyền là gì?",
      "options_vi": [
        "Cấm giới trẻ tiếp xúc với đồ cổ",
        "Kết hợp hoa văn truyền thống với đồ chơi nghệ thuật số và bối cảnh trò chơi tương tác hiện đại",
        "Bắt phạt nếu không mua đồ thủ công"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu thứ tư viết: 与现代数字潮玩、沉浸式互动游戏场景巧妙嫁接，播下热爱的火种."
    }
  ]
