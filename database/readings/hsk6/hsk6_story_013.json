  "quiz": [
    {
      "id": "q1",
      "question_vi": "Thách thức lớn nhất của thuốc y học cổ truyền khi tiếp cận y học thực chứng hiện đại là gì?",
      "options_vi": [
        "Không có người mua",
        "Khó khăn trong việc xác định hoạt chất chính xác và làm sáng tỏ cơ chế tác dụng",
        "Giá thành quá rẻ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 传统本草方剂往往面临有效成分不清、作用机理复杂的技术诘难."
    },
    {
      "id": "q2",
      "question_vi": "Ví dụ điển hình nhất về việc chiết xuất hoạt chất hiện đại từ thảo dược cổ truyền là gì?",
      "options_vi": [
        "Sản xuất cồn sát khuẩn",
        "Chiết xuất artemisinin (thanh hao tố) chữa sốt rét từ cây thanh hao hoa vàng",
        "Chế biến trà giải nhiệt"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 成功从青蒿中提取出抗疟特效药青蒿素."
    },
    {
      "id": "q3",
      "question_vi": "Mục tiêu chiến lược của việc kết hợp y học cổ truyền với khoa học hiện đại là gì?",
      "options_vi": [
        "Cung cấp giải pháp đổi mới sáng tạo mang đậm trí tuệ phương Đông cho y tế công cộng toàn cầu",
        "Xóa bỏ hoàn toàn y học phương Tây",
        "Giữ kín bí quyết gia truyền không chia sẻ"
      ],
      "answer": 0,
      "explanation_vi": "Trong câu cuối có viết: 为全球公共卫生事业提供独具东方智慧的创新方案."
    }
