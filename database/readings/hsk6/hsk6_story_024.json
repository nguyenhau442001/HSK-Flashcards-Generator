  "quiz": [
    {
      "id": "q1",
      "question_vi": "Cơ chế của hiện tượng 'đồng cảm thẩm mỹ' (审美移情) được hiểu như thế nào?",
      "options_vi": [
        "Chỉ nhìn ngắm màu sắc bên ngoài",
        "Người thưởng ngoạn chủ động phóng chiếu tình cảm và trải nghiệm sống của mình vào đối tượng nghệ thuật",
        "Học thuộc thông tin về tác giả"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 将自身的生命情感与人生体验主动投射于审美对象之中."
    },
    {
      "id": "q2",
      "question_vi": "Tranh của Van Gogh khơi gợi trạng thái cảm xúc gì nơi người xem?",
      "options_vi": [
        "Sự buồn ngủ",
        "Khuấy động dữ dội nỗi cô đơn và ngọn lửa đam mê sâu kín trong lòng",
        "Cảm giác sợ hãi không dám nhìn"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 画布上的每一道狂热笔触都在剧烈激荡着我们内心的孤独与炽热."
    },
    {
      "id": "q3",
      "question_vi": "Ý nghĩa tối thượng của trải nghiệm thẩm mỹ là gì?",
      "options_vi": [
        "Khoe khoang kiến thức nghệ thuật",
        "Vượt thoát vụn vặt đời thường, tìm kiếm sự thăng hoa tâm hồn qua sự cộng cảm sâu sắc",
        "Mua tranh để kiếm lời"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 超越日常生活的琐碎平庸，在与人类共同命运的深层共鸣中寻获灵魂的升华."
    }
  ]
