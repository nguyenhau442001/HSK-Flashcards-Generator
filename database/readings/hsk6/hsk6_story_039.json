  "quiz": [
    {
      "id": "q1",
      "question_vi": "Yếu tố cuốn hút nhất tạo nên sức mạnh của tác phẩm kịch nghệ là gì?",
      "options_vi": [
        "Sân khấu trang hoàng đắt tiền",
        "Kịch tính thăng trầm biến hóa cùng sự đối lập gay gắt của tính cách và số phận nhân vật",
        "Trang phục biểu diễn sặc sỡ"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 最扣人心弦的艺术魅力莫过于跌宕起伏的戏剧张力，构设尖锐的价值对立与性格冲突."
    },
    {
      "id": "q2",
      "question_vi": "Khái niệm 'Catharsis' (卡塔西斯) trong 'Thi học' của Aristotle có nghĩa là gì?",
      "options_vi": [
        "Tiếng cười sảng khoái thông thường",
        "Sự thanh lọc giải tỏa tâm hồn thông qua việc khơi gợi lòng trắc ẩn và nỗi sợ hãi",
        "Sự tức giận với nhân vật phản diện"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 通过引发观众内心的怜悯与恐惧，最终达成洗涤心灵污垢的卡塔西斯宣泄净化效应."
    },
    {
      "id": "q3",
      "question_vi": "Dư âm lớn nhất đọng lại trong tâm khán giả khi tấm màn kịch buông xuống là gì?",
      "options_vi": [
        "Sự mệt mỏi buồn ngủ",
        "Cú sốc thẩm mỹ tột đỉnh và tìm lại sức mạnh thuần khiết qua chiêm nghiệm nhân sinh",
        "Quên ngay nội dung vở kịch"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 不仅收获了审美的极致震撼，更在深刻省思中重获生命的纯粹与力量."
    }
