  "quiz": [
    {
      "id": "q1",
      "question_vi": "Hình ảnh âm thanh nào tượng trưng cho các đoàn thương buôn trên con đường tơ lụa cổ xưa?",
      "options_vi": [
        "Tiếng còi tàu hỏa",
        "Tiếng chuông lạc đà ngân vang giữa sa mạc",
        "Tiếng động cơ máy bay"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 清脆的骆驼铃声回荡在广袤无垠的沙漠绿洲之间."
    },
    {
      "id": "q2",
      "question_vi": "Ngoài hàng hóa buôn bán, Con đường Tơ Lụa còn truyền bá những gì?",
