  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mặt hạn chế khi doanh nghiệp chỉ áp dụng cứng nhắc quản lý định lượng phương Tây là gì?",
      "options_vi": [
        "Doanh thu tăng quá nhanh",
        "Gây ra sự xa lánh giữa đồng nghiệp và nhân viên thiếu cảm giác thuộc về tập thể",
        "Lương bổng quá cao"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 导致企业内部人际疏离、员工归属感缺失等异化困局."
    },
    {
      "id": "q2",
      "question_vi": "Triết lý Nho gia nào có thể bổ sung cho cách quản lý khô cứng này?",
      "options_vi": [
        "Lấy lợi ích làm đầu",
        "Nhân ái, lấy con người làm gốc (以人为本) và coi trọng chữ tín",
        "Chế độ thưởng phạt tùy tiện"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 汲取东方儒家仁爱互信、以人为本的核心思想."
    },
    {
      "id": "q3",
      "question_vi": "Bí quyết để doanh nghiệp xây dựng nền móng bền vững trăm năm là gì?",
      "options_vi": [
