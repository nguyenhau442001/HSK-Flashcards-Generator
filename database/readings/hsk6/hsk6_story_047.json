  "quiz": [
    {
      "id": "q1",
      "question_vi": "Điều kiện vật lý độc nhất vô nhị mà trạm vũ trụ mang lại là gì?",
      "options_vi": [
        "Nhiệt độ cực cao",
        "Môi trường vi trọng lực (không trọng lượng) liên tục, loại bỏ hiện tượng đối lưu và lắng đọng trọng lực",
        "Có nhiều oxy hơn mặt đất"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 持续微重力极端实验环境，重力驱动的自然对流与沉降现象几乎完全消失."
    },
    {
      "id": "q2",
      "question_vi": "Ưu thế của việc nuôi cấy tinh thể protein trong môi trường vi trọng lực là gì?",
      "options_vi": [
        "Tinh thể mọc rất nhanh",
        "Tinh thể lớn chậm, đều đặn, độ hoàn hảo mạng tinh thể cực cao giúp giải mã cấu trúc đích điều trị bệnh",
        "Tinh thể biến thành vàng"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 晶格缺陷极少的高质量蛋白质晶体，极大助力了新药靶点解析."
    },
