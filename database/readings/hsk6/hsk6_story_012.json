  "quiz": [
    {
      "id": "q1",
      "question_vi": "Theo bài viết, một nền văn minh có thể đơn độc phát triển rực rỡ mà không cần giao lưu không?",
      "options_vi": [
        "Có thể, nếu đủ giàu mạnh",
        "Không, không nền văn minh nào có thể tách rời giao lưu mà tự phồn vinh",
        "Chỉ các nền văn minh lớn mới làm được"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu đầu có viết: 没有任何一种文明能够孤芳自赏、脱离与其他文明的交流而独自繁盛."
    },
    {
      "id": "q2",
      "question_vi": "Thái độ đúng đắn trước sự khác biệt văn hóa giữa các quốc gia là gì?",
      "options_vi": [
        "Lấy đó làm lý do để gây chiến",
        "Xem sự khác biệt là nguồn cảm hứng học hỏi bù trừ cho nhau và đối thoại bình đẳng",
        "Đồng hóa mọi nền văn hóa thành một"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 文明的差异恰恰是彼此启迪、取长补短的宝贵源泉."
    },
