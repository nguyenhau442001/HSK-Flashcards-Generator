  "quiz": [
    {
      "id": "q1",
      "question_vi": "Phát hiện bất ngờ của các học giả văn học so sánh khi nghiên cứu thần thoại các nền văn minh là gì?",
      "options_vi": [
        "Mỗi nơi kể một chuyện hoàn toàn không liên quan",
        "Có sự trùng hợp cao độ về các mô-típ tự sự cốt lõi như đại hồng thủy, sáng thế",
        "Thần thoại chỉ có ở châu Âu"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 惊讶地发现了诸多高度吻合的核心母题叙事."
    },
    {
      "id": "q2",
      "question_vi": "Ví dụ tiêu biểu về ký ức tập thể chống thiên tai của nhân loại là gì?",
      "options_vi": [
