  "quiz": [
    {
      "id": "q1",
      "question_vi": "Mối nguy hiểm của việc canh tác độc canh một vài giống cây trồng cao sản là gì?",
      "options_vi": [
        "Không bán được nông sản",
        "Đồng nhất di truyền cao khiến cây trồng dễ bị xóa sổ hàng loạt khi dịch bệnh lạ hoặc hạn hán ập đến",
        "Tốn quá ít phân bón"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 单一遗传背景的作物群落极易遭受毁灭性的系统崩溃."
    },
