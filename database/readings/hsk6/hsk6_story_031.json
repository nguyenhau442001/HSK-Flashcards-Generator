  "quiz": [
    {
      "id": "q1",
      "question_vi": "Giả thuyết nền tảng của kinh tế học cổ điển truyền thống là gì?",
      "options_vi": [
        "Con người luôn hành động theo cảm tính",
        "Con người kinh tế hoàn toàn duy lý và tối đa hóa lợi ích",
        "Con người không thích tiền"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu đầu có viết: 建立在理性经济人的假说之上，设定个体总是做出利益最大化的最优选择."
    },
    {
      "id": "q2",
      "question_vi": "Hiện tượng tâm lý nào thúc đẩy sự phình to của bong bóng thị trường (非理性繁荣)?",
      "options_vi": [
        "Chi phí chìm, hiệu ứng đám đông và tâm lý sợ tổn thất",
        "Sự tính toán cẩn trọng tuyệt đối",
        "Không mua bán gì"
      ],
      "answer": 0,
      "explanation_vi": "Trong câu có viết: 沉没成本谬误、从众效应以及对损失的极端厌恶，助推非理性繁荣."
    },
    {
      "id": "q3",
