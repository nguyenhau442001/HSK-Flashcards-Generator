  "quiz": [
    {
      "id": "q1",
      "question_vi": "Điểm khác biệt cốt lõi giữa tranh thủy mặc phương Đông và hội họa cổ điển phương Tây là gì?",
      "options_vi": [
        "Tranh phương Đông dùng nhiều màu sặc sỡ hơn",
        "Tranh phương Đông đề cao ý cảnh 'hư thực tương sinh' và nghệ thuật để trống (lưu bạch), không phụ thuộc vào tả thực ánh sáng",
        "Tranh phương Tây không vẽ con người"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 东方古典美学更加推崇虚实相生的空灵意境，大面积保留未着一笔墨痕的纯净空白."
    },
    {
      "id": "q2",
      "question_vi": "Nghệ thuật 'lưu bạch' (chừa khoảng trống trắng) mang lại hiệu quả thẩm mỹ gì?",
      "options_vi": [
        "Khiến bức tranh dở dang",
        "'Nơi không vẽ đều thành cõi diệu', mở ra không gian tưởng tượng vô hạn về mây trời sông nước",
        "Tiết kiệm tiền mực vẽ"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu có viết: 借无画处皆成妙境的手法，赋予了云海苍茫、江流浩渺的无限想象空间."
    },
    {
      "id": "q3",
      "question_vi": "Nguyên lý 'Kế bạch đương hắc' (计白当黑 - coi khoảng trắng quan trọng như nét đen) dạy cho con người bài học gì?",
      "options_vi": [
        "Vẽ thật nhiều chi tiết kín giấy",
        "Trí tuệ tinh giản, biết chừa không gian tinh thần thanh thoát và cân bằng giữa hữu hình và vô hình",
        "Chỉ dùng giấy trắng"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 计白当黑的深邃智慧，提供着超然物外的审美滋养与精神呼吸空间."
    }
  ]
}