  "quiz": [
    {
      "id": "q1",
      "question_vi": "Cảnh quan hai bên con đường ven hồ có gì đẹp?",
      "options_vi": [
        "Các tòa nhà công xưởng",
        "Nở rộ những bông hoa tươi đủ màu sắc rực rỡ",
        "Chỉ có hàng rào sắt"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 湖边的绿道修得非常平整，两旁开满了五颜六色的鲜花."
    },
    {
      "id": "q2",
      "question_vi": "Hai người đã làm gì trong lúc đạp xe dạo hồ?",
      "options_vi": [
        "Chạy đua tốc độ cao",
        "Vừa đạp vừa dừng lại chụp ảnh lưu giữ cảnh đẹp",
        "Vừa đạp vừa xem điện thoại"
      ],
      "answer": 1,
      "explanation_vi": "Trong bài có câu: 一边骑一边停下来拍照，记录下美丽的湖光山色."
    },
    {
      "id": "q3",
      "question_vi": "Tác giả nhận xét thế nào về hoạt động đạp xe quanh hồ?",
      "options_vi": [
        "Tốn kém tiền bạc",
        "Vừa có lợi cho sức khỏe vừa bảo vệ môi trường",
        "Gây mệt mỏi vô ích"
      ],
      "answer": 1,
      "explanation_vi": "Trong câu cuối có viết: 既健康又环保的休闲方式，真是一种美好的享受."
    }
  ]
